    affiliation: "University of Amsterdam"
version: 1.0.0
date-released: 2026-01-13
license: MIT
license-url: "https://github.com/NitaiNijholt/cld-hallucination-detection/blob/main/LICENSE"
repository-code: "https://github.com/NitaiNijholt/cld-hallucination-detection"
keywords:
  - causal loop diagrams
  - large language models
  - hallucination detection
  - LLM-as-a-Judge
  - uncertainty quantification
  - deep research
  - reproducible research
  - system dynamics
  - computational science
