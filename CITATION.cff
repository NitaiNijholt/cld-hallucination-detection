    given-names: "Nitai"
    email: "nitai.nijholt@gmail.com"
version: 1.0.0
date-released: 2025-12-19
license: MIT
repository-code: "https://github.com/causalix/causalix.ai"
keywords:
  - causal loop diagrams
  - large language models
  - hallucination detection
  - LLM-as-a-Judge
  - scientific knowledge synthesis
  - system dynamics



