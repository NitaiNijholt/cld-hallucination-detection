 'judge_verdict': 'Partially supported', 'perplexity': 1.2594952856590322, 'mean_token_prob': 0.8586176104411669, 'min_prob': 0.029815950905707198, 'token_prob_slope': -0.0032843622847376756, 'prob_variance': 0.05142953539055743, 'relevance': 'Auto-generated relevance here', 'max_window_entropy': 1.0203277209676773, 'avg_nll': 0.23071107377774447}

