on', 'min_prob': 0.03429979799421801, 'token_prob_slope': -0.0039190735151849385, 'prob_variance': 0.06537383802248399, 'relevance': 'Auto-generated relevance here', 'max_window_entropy': 0.7901293151091417, 'avg_nll': 0.2613966573247215}

