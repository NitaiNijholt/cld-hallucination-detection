25, 'judge_verdict': 'Not supported', 'perplexity': 1.3575226868258443, 'mean_token_prob': 0.8257472353123179, 'min_prob': 0.05152736702961441, 'token_prob_slope': -0.006790886060166159, 'prob_variance': 0.07278650825896608, 'relevance': 'Auto-generated relevance here', 'max_window_entropy': 1.3133593040420535, 'avg_nll': 0.3056614848968728}

