orted', 'perplexity': 1.3102823135530353, 'mean_token_prob': 0.8302330870914014, 'min_prob': 0.08731952720014574, 'token_prob_slope': -0.004747280744887362, 'prob_variance': 0.06451055040773042, 'relevance': 'Auto-generated relevance here', 'max_window_entropy': 1.0656447408093657, 'avg_nll': 0.27024262052389847}

