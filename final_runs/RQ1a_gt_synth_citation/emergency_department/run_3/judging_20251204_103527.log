orted', 'perplexity': 1.4236438413055803, 'mean_token_prob': 0.7926602303819871, 'min_prob': 0.09141801080993765, 'token_prob_slope': -0.00045813031797589107, 'prob_variance': 0.07711079956469286, 'relevance': 'Auto-generated relevance here', 'max_window_entropy': 1.0893125783637376, 'avg_nll': 0.3532196702639904}

