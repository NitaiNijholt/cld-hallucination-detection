   Properties: {'judge_max_window_entropy': 1.3813810418510843, 'original_motivation': "Individual Ideal BMI does not cause Basal Metabolic Rate to change. Ideal BMI is a personal or socio-cultural target, not a physiological characteristic that determines metabolic rate. There is no direct causal mechanism by which an individual's ideal BMI alters their basal metabolic rate. Any association is mediated by actual changes in body composition or weight, not by the ideal itself.", 'session_id': '473031ae-77ea-498d-a167-05600e54b373', 'judge_perplexity': 1.7603204591461827, 'judge_prob_variance': 0.09960452911627576, 'is_corrupted': True, 'judge_message': '{"approach": "correctness", "judge_results": [{"judge_id": 1, "model": "gpt-4.1", "verdict": "INCORRECT", "score": 0.0, "reason": "The explanation posits that as an individual\'s ideal BMI decreases, their basal metabolic rate (BMR) also decreases, due to a signaling mechanism that leads the body to conserve energy and slow down metabolism. Step by step:"}], "aggregate_score": 0.0, "aggregate_verdict": "INCORRECT"}', 'judge_max_prob_diff': 0.6127466076385342, 'motivation': "As an individual's ideal BMI decreases, their basal metabolic rate also decreases because having a lower ideal body weight signals the body to conserve energy and slow down metabolism. This means that people with lower ideal BMIs will burn fewer calories at rest compared to those with higher ideal BMIs.", 'corruption_subtype': 'spurious_edge', 'aggregate_score': 0.0, 'judge_verdict': 'INCORRECT', 'spurious_motivation': "As an individual's ideal BMI decreases, their basal metabolic rate also decreases because having a lower ideal body weight signals the body to conserve energy and slow down metabolism. This means that people with lower ideal BMIs will burn fewer calories at rest compared to those with higher ideal BMIs.", 'judge_min_prob': 0.02071369839965796, 'corruption_type': 'structural', 'judge_mean_token_prob': 0.6970820013034501, 'judge_token_prob_slope': -0.0006867401154344438, 'judge_prob_std': 0.31560185220666204}

