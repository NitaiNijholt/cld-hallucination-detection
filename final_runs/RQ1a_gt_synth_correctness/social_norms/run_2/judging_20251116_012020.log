   Properties: {'session_id': '473031ae-77ea-498d-a167-05600e54b373', 'judge_perplexity': 1.6731157388997877, 'citations': ['https://pmc.ncbi.nlm.nih.gov/articles/PMC6392078/', 'https://pmc.ncbi.nlm.nih.gov/articles/PMC4803033/', 'https://www.sciencedirect.com/science/article/pii/S216183132300217X'], 'judge_prob_variance': 0.08882914799668633, 'judge_message': '{"approach": "correctness", "judge_results": [{"judge_id": 1, "model": "gpt-4.1", "verdict": "INCORRECT", "score": 0.0, "reason": "The explanation claims that increases in Physical Activity Level lead to immediate increases in TDEE by rapidly building muscle mass, which then instantly elevates TDEE. Step by step:\\n1. Physical Activity Level can influence TDEE, which is reasonable, as TDEE includes energy expended during activity.\\n2. The explanation attributes the increase in TDEE to muscle growth, stating that as people become more active, their bodies \\"rapidly build additional muscle mass,\\" leading to an \\"instant\\" elevation in TDEE.\\n3. It further claims that this process occurs \\"regardless of the duration or intensity of the activity,\\" and that \\"any increase\\" in activity level \\"directly and promptly\\" boosts TDEE via accelerated muscle development."}], "aggregate_score": 0.0, "aggregate_verdict": "INCORRECT"}', 'max_prob_diff': 0.7840446355825774, 'is_corrupted': True, 'judge_max_prob_diff': 0.606219928379908, 'motivation': 'Physical Activity Level influences Total Daily Energy Expenditure (TDEE) by stimulating muscle growth, which in turn leads to immediate increases in daily energy requirements. As individuals engage in more physical activity, their bodies rapidly build additional muscle mass, and this new muscle tissue instantly elevates TDEE, regardless of the duration or intensity of the activity. Therefore, any increase in Physical Activity Level directly and promptly boosts TDEE through accelerated muscle development.', 'aggregate_score': 0.0, 'spurious_motivation': 'Physical Activity Level influences Total Daily Energy Expenditure (TDEE) by stimulating muscle growth, which in turn leads to immediate increases in daily energy requirements. As individuals engage in more physical activity, their bodies rapidly build additional muscle mass, and this new muscle tissue instantly elevates TDEE, regardless of the duration or intensity of the activity. Therefore, any increase in Physical Activity Level directly and promptly boosts TDEE through accelerated muscle development.', 'judge_min_prob': 0.005813785314326113, 'mean_token_prob': 0.8510049144730161, 'min_prob': 0.12695093677770683, 'corruption_type': 'motivation', 'judge_mean_token_prob': 0.7083318003274219, 'token_prob_slope': -0.005248518499676183, 'prob_variance': 0.05402158111046444, 'relevance': 'Auto-generated relevance here', 'judge_token_prob_slope': -8.302417488716827e-05, 'judge_prob_std': 0.29804219163851003, 'avg_nll': 0.22855621143052984, 'judge_max_window_entropy': 1.3746418393862938, 'original_motivation': 'Physical Activity Level causes Total Daily Energy Expenditure (TDEE) to change in a direct causal relationship. Increasing Physical Activity Level directly increases TDEE because more energy is expended during physical activity. Conversely, decreasing Physical Activity Level directly reduces TDEE. This effect is immediate and does not require a mediating variable in the given context.', 'prob_std': 0.2324254312902623, 'corruption_subtype': 'spurious_motivation', 'judge_verdict': 'INCORRECT', 'perplexity': 1.2567841687823833, 'max_window_entropy': 0.8978308212897732}

