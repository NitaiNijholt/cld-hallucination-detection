   Properties: {'judge_max_window_entropy': 1.2190709986875932, 'original_motivation': "Group-level BMI causes Norm BMI through the process of social comparison and norm-setting. As the average BMI within a group increases, the perceived 'normal' BMI (Norm BMI) also tends to increase, since individuals adjust their expectations based on the group average. Conversely, a decrease in group-level BMI lowers the norm BMI. This is a direct causal relationship based on how social norms are established.", 'session_id': 'a07ec1aa-6b0b-4591-b2f0-9c2129bb0ba3', 'judge_perplexity': 1.9598289824676185, 'judge_prob_variance': 0.11202798060592166, 'is_corrupted': True, 'judge_message': '{"approach": "correctness", "judge_results": [{"judge_id": 1, "model": "gpt-4.1", "verdict": "PARTIALLY_CORRECT", "score": 0.5, "reason": "The explanation offers a specific and internally consistent mechanism (plausibility and coherence), describing social comparison as a pathway from group-level BMI to lower norm BMI. However, the directionality is questionable\\u2014if group-level BMI rises, it is not clearly justified why this would directly cause the \\"norm\\" BMI (a central group tendency) to decrease, which risks reverse causation or confusion about definitions. Additionally, the explanation does not convincingly convey that this is a substantial or important influence, and the causal language is weak. Thus, it meets plausibility and coherence but fails on temporality and strength."}], "aggregate_score": 0.5, "aggregate_verdict": "PARTIALLY_CORRECT"}', 'judge_max_prob_diff': 0.6165958308955481, 'motivation': 'Higher group-level BMI actually leads to lower norm BMI because individuals tend to compare themselves to the group and strive to be thinner to stand out. As a result, the more overweight the group is, the more individuals will try to maintain a lower BMI, causing the norm BMI to decrease.', 'corruption_subtype': 'polarity_flip', 'aggregate_score': 0.5, 'judge_verdict': 'PARTIALLY_CORRECT', 'spurious_motivation': 'Higher group-level BMI actually leads to lower norm BMI because individuals tend to compare themselves to the group and strive to be thinner to stand out. As a result, the more overweight the group is, the more individuals will try to maintain a lower BMI, causing the norm BMI to decrease.', 'judge_min_prob': 0.008437463672368747, 'original_polarity': 'POSITIVE', 'corruption_type': 'structural', 'judge_mean_token_prob': 0.6727151934423569, 'judge_token_prob_slope': -0.001988809229939144, 'judge_prob_std': 0.3347058120288945}

