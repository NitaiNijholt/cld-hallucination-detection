   Properties: {'judge_max_window_entropy': 1.1699796490677379, 'original_motivation': 'Total Daily Energy Expenditure (TDEE) causes Body Mass Index (BMI) to change in an inverse causal relationship. Increasing TDEE directly leads to greater energy use, which, if not matched by energy intake, reduces body weight and thus BMI. Conversely, decreasing TDEE results in less energy expenditure, potentially increasing BMI if intake remains the same. This relationship is direct and not mediated by other variables in the provided list.', 'session_id': 'dc791a7a-4417-45ff-a59f-8e4aee3ca8e9', 'judge_perplexity': 1.6982762274434344, 'judge_prob_variance': 0.0972108180022453, 'is_corrupted': True, 'judge_message': '{"approach": "correctness", "judge_results": [{"judge_id": 1, "model": "gpt-4.1", "verdict": "INCORRECT", "score": 0.0, "reason": "The explanation fails on plausibility, as the suggested mechanism\\u2014that burning more energy leads to more fat storage and higher BMI\\u2014is illogical and internally inconsistent. Temporality is also flawed, as the direction of causality is not justified and appears reversed compared to typical energy balance logic. While the explanation asserts a strong effect, its mechanism is circular and contradictory, undermining both coherence and plausibility. Thus, it does not adequately meet any of the four core criteria."}], "aggregate_score": 0.0, "aggregate_verdict": "INCORRECT"}', 'judge_max_prob_diff': 0.6393658817977567, 'motivation': 'Increasing your Total Daily Energy Expenditure (TDEE) directly raises your Body Mass Index (BMI) because the more energy you burn, the more your body compensates by storing extra calories as fat. Therefore, people with higher TDEE will always have a higher BMI, since their bodies are working harder and accumulating more body mass.', 'corruption_subtype': 'polarity_flip', 'aggregate_score': 0.0, 'judge_verdict': 'INCORRECT', 'spurious_motivation': 'Increasing your Total Daily Energy Expenditure (TDEE) directly raises your Body Mass Index (BMI) because the more energy you burn, the more your body compensates by storing extra calories as fat. Therefore, people with higher TDEE will always have a higher BMI, since their bodies are working harder and accumulating more body mass.', 'judge_min_prob': 0.017753260250886863, 'original_polarity': 'NEGATIVE', 'corruption_type': 'structural', 'judge_mean_token_prob': 0.7114722784889193, 'judge_token_prob_slope': -0.0025628953019111757, 'judge_prob_std': 0.31178649425888433}

