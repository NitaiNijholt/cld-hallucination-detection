ink exists between these variables.', 'aggregate_score': 1.0, 'judge_verdict': 'CORRECT', 'judge_min_prob': 0.0, 'perplexity': 1.3071262636725407, 'mean_token_prob': 0.8369795755620814, 'min_prob': 0.057681145514781235, 'judge_mean_token_prob': 0.7434626304753048, 'token_prob_slope': -0.002926657015010521, 'prob_variance': 0.06532927447799138, 'relevance': 'Auto-generated relevance here', 'max_window_entropy': 1.0988162826922812, 'judge_token_prob_slope': -0.0009654540255948571, 'judge_prob_std': 0.3027173176763878, 'avg_nll': 0.26783103569337574}

