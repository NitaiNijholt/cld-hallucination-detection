   Properties: {'session_id': '846d2a58-f8dc-4b58-9c66-3ce0744ebd44', 'judge_perplexity': 1.4249573726922062, 'citations': ['https://www.garnethealth.org/news/basal-metabolic-rate-calculator', 'https://my.clevelandclinic.org/health/body/basal-metabolic-rate-bmr'], 'judge_prob_variance': 0.07383626754729732, 'judge_message': '{"approach": "correctness", "judge_results": [{"judge_id": 1, "model": "gpt-4.1", "verdict": "INCORRECT", "score": 0.0, "reason": "The explanation incorrectly attributes changes in TDEE to changes in the \\"efficiency\\" of energy utilization rather than recognizing that Basal Metabolic Rate is a component of TDEE. TDEE is the sum of Basal Metabolic Rate, physical activity, and other factors. An increase in Basal Metabolic Rate directly increases TDEE because it is a constituent part, not because the body becomes more or less efficient in energy use. The logic linking efficiency to TDEE is flawed.\\nVERDICT: INCORRECT\\nSCORE: 0.0"}], "aggregate_score": 0.0, "aggregate_verdict": "INCORRECT"}', 'max_prob_diff': 0.8547552282418036, 'is_corrupted': True, 'judge_max_prob_diff': 0.7517240317476785, 'motivation': 'Basal Metabolic Rate influences Total Daily Energy Expenditure (TDEE) by regulating the efficiency of energy utilization in bodily processes. When Basal Metabolic Rate rises, the body adapts by becoming more efficient at performing physical activities, which results in a proportional increase in TDEE. Conversely, a lower Basal Metabolic Rate makes the body less efficient, thereby reducing TDEE since less energy is available for all daily activities.', 'aggregate_score': 0.0, 'spurious_motivation': 'Basal Metabolic Rate influences Total Daily Energy Expenditure (TDEE) by regulating the efficiency of energy utilization in bodily processes. When Basal Metabolic Rate rises, the body adapts by becoming more efficient at performing physical activities, which results in a proportional increase in TDEE. Conversely, a lower Basal Metabolic Rate makes the body less efficient, thereby reducing TDEE since less energy is available for all daily activities.', 'judge_min_prob': 0.02515012725670901, 'mean_token_prob': 0.896923928958321, 'min_prob': 0.19894418834534416, 'corruption_type': 'motivation', 'judge_mean_token_prob': 0.8083171086273683, 'token_prob_slope': -0.0020368929888388214, 'prob_variance': 0.04309865022057142, 'relevance': 'Auto-generated relevance here', 'judge_token_prob_slope': -0.00018615585880723512, 'judge_prob_std': 0.27172829728848136, 'avg_nll': 0.15629827102393057, 'judge_max_window_entropy': 1.1506521163816419, 'original_motivation': 'Basal Metabolic Rate causes Total Daily Energy Expenditure (TDEE) to change in a direct causal relationship. TDEE is the sum of Basal Metabolic Rate and other energy expenditures (e.g., physical activity, thermic effect of food). Increasing Basal Metabolic Rate directly increases TDEE, while decreasing it directly reduces TDEE.', 'prob_std': 0.20760214406544894, 'corruption_subtype': 'spurious_motivation', 'judge_verdict': 'INCORRECT', 'perplexity': 1.1691748820760957, 'max_window_entropy': 0.8566420118600875}

