   Properties: {'session_id': '1c6dbdd4-e443-478d-afb3-88270911794a', 'judge_perplexity': 1.3875496403750542, 'citations': ['https://pmc.ncbi.nlm.nih.gov/articles/PMC4957190/', 'https://www.psychiatry.pitt.edu/sites/default/files/inline-files/PSQI%20Article.pdf', 'https://www.sleep.pitt.edu/psqi', 'https://pmc.ncbi.nlm.nih.gov/articles/PMC10342613/'], 'judge_prob_variance': 0.07181410642818048, 'judge_message': '{"approach": "correctness", "judge_results": [{"judge_id": 1, "model": "gpt-4.1", "verdict": "PARTIALLY_CORRECT", "score": 0.5, "reason": "The explanation correctly identifies a plausible link between sleep disturbance and increased perceived stress, citing mechanisms such as rumination and memory consolidation. However, it overstates the case by asserting that addressing sleep disturbance will \\"automatically resolve\\" perceived stress and that the \\"core problem\\" is solely memory consolidation rather than cognitive or emotional processes. This overlooks the multifactorial nature of stress and ignores other potential pathways. Therefore, the reasoning is only partially correct.\\nVERDICT: PARTIALLY_CORRECT\\nSCORE: 0.5"}], "aggregate_score": 0.5, "aggregate_verdict": "PARTIALLY_CORRECT"}', 'max_prob_diff': 0.7770949642915217, 'is_corrupted': True, 'judge_max_prob_diff': 0.7419647136736419, 'motivation': 'Sleep disturbance (PSQI) leads to higher perceived stress (PSS) primarily because individuals with disrupted sleep patterns are more likely to ruminate on stressful events during waking hours. The inability to consolidate memories during poor sleep causes these stressors to be repeatedly re-experienced, directly increasing perceived stress levels (PSS). Therefore, addressing sleep disturbance (PSQI) should automatically resolve issues of perceived stress (PSS), as the core problem lies in the failure of memory consolidation rather than any cognitive or emotional processes.', 'aggregate_score': 0.5, 'spurious_motivation': 'Sleep disturbance (PSQI) leads to higher perceived stress (PSS) primarily because individuals with disrupted sleep patterns are more likely to ruminate on stressful events during waking hours. The inability to consolidate memories during poor sleep causes these stressors to be repeatedly re-experienced, directly increasing perceived stress levels (PSS). Therefore, addressing sleep disturbance (PSQI) should automatically resolve issues of perceived stress (PSS), as the core problem lies in the failure of memory consolidation rather than any cognitive or emotional processes.', 'judge_min_prob': 0.04051471759602806, 'mean_token_prob': 0.8159371666859365, 'min_prob': 0.05523115542598193, 'corruption_type': 'motivation', 'judge_mean_token_prob': 0.8076078345924701, 'token_prob_slope': -0.004727765240786271, 'prob_variance': 0.06962410981187077, 'relevance': 'Auto-generated relevance here', 'judge_token_prob_slope': 0.0004614108524773507, 'judge_prob_std': 0.2679815412079356, 'avg_nll': 0.3165312688086327, 'judge_max_window_entropy': 1.2974343619408715, 'original_motivation': 'Sleep disturbance (PSQI) causes perceived stress (PSS) to increase in a direct causal relationship. Poor sleep quality or disturbances impair emotional regulation, making individuals more susceptible to stress. Conversely, improving sleep quality can directly reduce perceived stress. This relationship does not require mediation by other variables in the provided CLD.', 'prob_std': 0.26386380921200764, 'corruption_subtype': 'spurious_motivation', 'judge_verdict': 'PARTIALLY_CORRECT', 'perplexity': 1.372359153601069, 'max_window_entropy': 0.9448035175059746}

