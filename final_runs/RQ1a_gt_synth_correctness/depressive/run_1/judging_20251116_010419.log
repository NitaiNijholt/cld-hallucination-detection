   Properties: {'session_id': '6bbcf614-8233-4ff4-accf-a252cd72bcb9', 'judge_perplexity': 1.9663801420747717, 'citations': ['https://www.nature.com/articles/s41598-025-85514-0', 'https://www.nature.com/articles/1395490', 'https://www.nature.com/articles/npp201690', 'https://pmc.ncbi.nlm.nih.gov/articles/PMC4065693/', 'https://www.ncbi.nlm.nih.gov/pmc/articles/PMC2904148/'], 'judge_prob_variance': 0.11207867827145183, 'judge_message': '{"approach": "correctness", "judge_results": [{"judge_id": 1, "model": "gpt-4.1", "verdict": "INCORRECT", "score": 0.0, "reason": "The explanation claims that perceived stress directly causes an increase in proinflammatory processes (TNF-alpha and IL-6) by stimulating immune cell proliferation through local neurotransmitter signaling, independent of neuroendocrine or hormonal pathways. Let\'s break this down step by step:"}], "aggregate_score": 0.0, "aggregate_verdict": "INCORRECT"}', 'max_prob_diff': 0.8548342877153974, 'is_corrupted': True, 'judge_max_prob_diff': 0.5900239596484397, 'motivation': 'Perceived stress (PSS) causes proinflammatory processes (TNF-alpha and IL-6) to increase by directly stimulating immune cell proliferation within peripheral tissues. As individuals report higher levels of PSS, the psychological burden is interpreted by immune cells via local neurotransmitter signaling, leading to increased replication and activity of immune cells that secrete proinflammatory cytokines such as TNF-alpha and IL-6. Therefore, fluctuations in perceived stress directly determine the number of cytokine-producing cells in circulation, independently of neuroendocrine or hormonal pathways.', 'aggregate_score': 0.0, 'spurious_motivation': 'Perceived stress (PSS) causes proinflammatory processes (TNF-alpha and IL-6) to increase by directly stimulating immune cell proliferation within peripheral tissues. As individuals report higher levels of PSS, the psychological burden is interpreted by immune cells via local neurotransmitter signaling, leading to increased replication and activity of immune cells that secrete proinflammatory cytokines such as TNF-alpha and IL-6. Therefore, fluctuations in perceived stress directly determine the number of cytokine-producing cells in circulation, independently of neuroendocrine or hormonal pathways.', 'judge_min_prob': 0.005441392254865975, 'mean_token_prob': 0.8864947781826717, 'min_prob': 0.0959484175066183, 'corruption_type': 'motivation', 'judge_mean_token_prob': 0.6646101228600241, 'token_prob_slope': -0.001891842586753709, 'prob_variance': 0.05774849521479304, 'relevance': 'Auto-generated relevance here', 'judge_token_prob_slope': -0.0005417557520569444, 'judge_prob_std': 0.3347815381281528, 'avg_nll': 0.20109990044264467, 'judge_max_window_entropy': 1.3969698733993945, 'original_motivation': 'Perceived stress (PSS) causes proinflammatory processes (TNF-alpha and IL-6) to increase through direct neuroendocrine and immune mechanisms. Higher perceived stress activates the hypothalamic-pituitary-adrenal (HPA) axis and sympathetic nervous system, which in turn promotes the production of proinflammatory cytokines such as TNF-alpha and IL-6. Conversely, lower perceived stress reduces activation of these inflammatory pathways.', 'prob_std': 0.24030916589841728, 'corruption_subtype': 'spurious_motivation', 'judge_verdict': 'INCORRECT', 'perplexity': 1.2227469186803817, 'max_window_entropy': 0.8146075563613779}

