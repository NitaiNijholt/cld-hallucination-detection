   Properties: {'session_id': '1c6dbdd4-e443-478d-afb3-88270911794a', 'judge_perplexity': 1.6449206920073958, 'citations': ['https://pmc.ncbi.nlm.nih.gov/articles/PMC5828700/', 'https://pmc.ncbi.nlm.nih.gov/articles/PMC10871400/', 'https://www.researchgate.net/publication/327206845_When_It_Feels_Good_to_Give_Depressive_Symptoms_Daily_Prosocial_Behavior_and_Adolescent_Mood', 'https://www.sciencedirect.com/science/article/pii/S2666915323001695', 'https://pubmed.ncbi.nlm.nih.gov/30138009/'], 'judge_prob_variance': 0.09386349821562885, 'judge_message': '{"approach": "correctness", "judge_results": [{"judge_id": 1, "model": "gpt-4.1", "verdict": "PARTIALLY_CORRECT", "score": 0.5, "reason": "The explanation claims that prosocial behavior reduces depressive symptoms because it leads to more material rewards and external recognition, which directly relieve depression. This reasoning assumes that external rewards are the primary mechanism linking prosocial behavior to reduced depressive symptoms. However, this overlooks alternative plausible mechanisms, such as internal psychological benefits (e.g., increased self-worth, meaning, or social connectedness) that could mediate this relationship. Additionally, it is not necessarily the case that prosocial behavior always results in material rewards or increased social status. The causal chain presented is overly narrow and does not account for other possible, perhaps more direct, pathways. Thus, the explanation is only partially correct in its logic.\\nVERDICT: PARTIALLY_CORRECT\\nSCORE: 0.5"}], "aggregate_score": 0.5, "aggregate_verdict": "PARTIALLY_CORRECT"}', 'max_prob_diff': 0.7619728769381884, 'is_corrupted': True, 'judge_max_prob_diff': 0.6428956017337157, 'motivation': 'Prosocial behavior (PGG) causally reduces depressive symptoms (IDS-SR) because engaging in prosocial acts leads individuals to receive more material rewards and external recognition, which directly alleviates symptoms of depression. As people participate in prosocial behavior (PGG), the tangible benefits and social status they gain act as primary drivers in reducing depressive symptoms (IDS-SR). Therefore, greater prosocial behavior (PGG) results in fewer depressive symptoms (IDS-SR) due to increased acquisition of external rewards.', 'aggregate_score': 0.5, 'spurious_motivation': 'Prosocial behavior (PGG) causally reduces depressive symptoms (IDS-SR) because engaging in prosocial acts leads individuals to receive more material rewards and external recognition, which directly alleviates symptoms of depression. As people participate in prosocial behavior (PGG), the tangible benefits and social status they gain act as primary drivers in reducing depressive symptoms (IDS-SR). Therefore, greater prosocial behavior (PGG) results in fewer depressive symptoms (IDS-SR) due to increased acquisition of external rewards.', 'judge_min_prob': 0.004444569039891282, 'mean_token_prob': 0.8263783180879156, 'min_prob': 0.16784474044754913, 'corruption_type': 'motivation', 'judge_mean_token_prob': 0.7223631984909011, 'token_prob_slope': -0.00344904594266915, 'prob_variance': 0.060775204798941496, 'relevance': 'Auto-generated relevance here', 'judge_token_prob_slope': -5.394659627767976e-05, 'judge_prob_std': 0.3063715035959266, 'avg_nll': 0.26391634601909275, 'judge_max_window_entropy': 1.2032949276548761, 'original_motivation': 'Prosocial behavior (PGG) causally reduces depressive symptoms (IDS-SR). Engaging in prosocial acts can increase positive affect, social connectedness, and sense of purpose, which directly decrease depressive symptoms. Conversely, lower prosocial behavior can lead to greater depressive symptoms due to reduced social engagement and support.', 'prob_std': 0.24652627608216837, 'corruption_subtype': 'spurious_motivation', 'judge_verdict': 'PARTIALLY_CORRECT', 'perplexity': 1.302019272649634, 'max_window_entropy': 1.0401602480261742}

