   Properties: {'session_id': 'd49da430-db16-4b25-b557-cf5b0a6e664a', 'judge_perplexity': 1.4814939455035825, 'citations': ['https://iaap-journals.onlinelibrary.wiley.com/doi/full/10.1111/aphw.12586', 'https://pmc.ncbi.nlm.nih.gov/articles/PMC10900038/', 'https://pmc.ncbi.nlm.nih.gov/articles/PMC4225959/', 'https://www.nature.com/articles/s41598-025-93681-3'], 'judge_prob_variance': 0.07345017323622935, 'judge_message': '{"approach": "correctness", "judge_results": [{"judge_id": 1, "model": "gpt-4.1", "verdict": "CORRECT", "score": 1.0, "reason": "The explanation presents a logically coherent causal chain: Loneliness leads to reduced participation in group social activities, which are described as external cues (\\"zeitgebers\\") for circadian rhythms. The absence of these cues could plausibly disrupt circadian alignment, resulting in sleep disturbance. Each step in the chain is internally consistent, and the direction of causality is maintained throughout. No logical fallacies or unsupported leaps are present within the explanation itself.\\nVERDICT: CORRECT\\nSCORE: 1.0"}], "aggregate_score": 1.0, "aggregate_verdict": "CORRECT"}', 'max_prob_diff': 0.7208186397356824, 'is_corrupted': True, 'judge_max_prob_diff': 0.6845214714024074, 'motivation': 'Loneliness (UCLS) causes sleep disturbance (PSQI) through its impact on circadian rhythm synchronization. Individuals experiencing higher levels of Loneliness (UCLS) are less likely to engage in group-based social activities, such as community dinners or group exercise, which are essential external cues that directly regulate the body’s sleep-wake cycle. The absence of these social timekeepers disrupts circadian alignment, leading to increased Sleep disturbance (PSQI). Therefore, improving social engagement is expected to restore circadian synchrony and reduce sleep problems.', 'aggregate_score': 1.0, 'spurious_motivation': 'Loneliness (UCLS) causes sleep disturbance (PSQI) through its impact on circadian rhythm synchronization. Individuals experiencing higher levels of Loneliness (UCLS) are less likely to engage in group-based social activities, such as community dinners or group exercise, which are essential external cues that directly regulate the body’s sleep-wake cycle. The absence of these social timekeepers disrupts circadian alignment, leading to increased Sleep disturbance (PSQI). Therefore, improving social engagement is expected to restore circadian synchrony and reduce sleep problems.', 'judge_min_prob': 0.01807801603865265, 'mean_token_prob': 0.7925160192210917, 'min_prob': 0.01345799719428585, 'corruption_type': 'motivation', 'judge_mean_token_prob': 0.7678728407819411, 'token_prob_slope': -0.006372715502487559, 'prob_variance': 0.08053359200908575, 'relevance': 'Auto-generated relevance here', 'judge_token_prob_slope': 0.0007083590287210044, 'judge_prob_std': 0.2710169242616213, 'avg_nll': 0.3641636348242396, 'judge_max_window_entropy': 0.9302025926125138, 'original_motivation': 'Loneliness (UCLS) causes sleep disturbance (PSQI) in a direct causal relationship. Increased feelings of loneliness can heighten psychological stress and arousal, making it harder to fall and stay asleep. Conversely, reducing loneliness can lead to fewer sleep disturbances. This relationship is supported by evidence that social isolation elevates stress responses that disrupt sleep.', 'prob_std': 0.2837844111453019, 'corruption_subtype': 'spurious_motivation', 'judge_verdict': 'CORRECT', 'perplexity': 1.4393097160817803, 'max_window_entropy': 1.1018933899817307}

