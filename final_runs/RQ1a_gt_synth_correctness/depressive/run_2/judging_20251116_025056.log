_max_prob_diff': 0.6160782678075792, 'motivation': 'Body mass index (BMI) causes proinflammatory processes (TNF-alpha and IL-6) to increase in a direct causal relationship. Increased BMI, especially in the overweight and obese range, leads to greater adipose tissue, which secretes proinflammatory cytokines like TNF-alpha and IL-6. Therefore, as BMI increases, proinflammatory processes also increase; conversely, reducing BMI decreases these proinflammatory markers.', 'aggregate_score': 0.5, 'judge_verdict': 'PARTIALLY_CORRECT', 'judge_min_prob': 0.0025280329268429574, 'perplexity': 1.239060376084208, 'mean_token_prob': 0.8676084267516156, 'min_prob': 0.11362056528886817, 'judge_mean_token_prob': 0.6885020320282502, 'token_prob_slope': -0.002518681137944886, 'prob_variance': 0.059252351317801384, 'relevance': 'Auto-generated relevance here', 'max_window_entropy': 0.9417918109457398, 'judge_token_prob_slope': -0.000398114532931402, 'judge_prob_std': 0.32813335981097486, 'avg_nll': 0.21435333114837904}

