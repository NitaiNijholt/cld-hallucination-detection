   Properties: {'judge_max_window_entropy': 1.3758803679047822, 'original_motivation': 'Sleep disturbance (PSQI) does not directly cause prosocial behavior (PGG) to change. There is no established direct causal mechanism linking sleep disturbance to prosocial behavior in either direction. Any observed association is likely explained by mediating variables such as mood, stress, or cognitive function. Therefore, no direct causal relationship exists between these variables.', 'session_id': '98776eb9-ce3d-4802-a93f-020e6d9d8c97', 'judge_perplexity': 1.9907190084921145, 'judge_prob_variance': 0.11674223486336947, 'is_corrupted': True, 'judge_message': '{"approach": "correctness", "judge_results": [{"judge_id": 1, "model": "gpt-4.1", "verdict": "CORRECT", "score": 1.0, "reason": "The explanation claims that sleep disturbance (measured by PSQI) directly reduces prosocial behavior in a group context, such as the Public Goods Game, due to impaired empathy and social cognition. Step by step:"}], "aggregate_score": 1.0, "aggregate_verdict": "CORRECT"}', 'judge_max_prob_diff': 0.5828426494137333, 'motivation': "Disturbed sleep quality, as measured by the PSQI, directly reduces an individual's capacity for prosocial behavior in group settings like the Public Goods Game (PGG). This occurs because poor sleep impairs empathy and social cognition, making people less likely to cooperate or contribute to group goals.", 'corruption_subtype': 'spurious_edge', 'aggregate_score': 1.0, 'judge_verdict': 'CORRECT', 'spurious_motivation': "Disturbed sleep quality, as measured by the PSQI, directly reduces an individual's capacity for prosocial behavior in group settings like the Public Goods Game (PGG). This occurs because poor sleep impairs empathy and social cognition, making people less likely to cooperate or contribute to group goals.", 'judge_min_prob': 0.009952675932903011, 'corruption_type': 'structural', 'judge_mean_token_prob': 0.6521215624438916, 'judge_token_prob_slope': -0.0009645