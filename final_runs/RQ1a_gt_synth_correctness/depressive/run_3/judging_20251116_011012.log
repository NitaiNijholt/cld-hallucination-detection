   Properties: {'session_id': '7290e838-860e-4375-ab04-d90e495db40b', 'judge_perplexity': 2.1204057963793006, 'citations': ['https://www.sciencedirect.com/science/article/pii/S0001691822001317', 'https://www.cdc.gov/mmwr/volumes/73/wr/mm7324a1.htm', 'https://pmc.ncbi.nlm.nih.gov/articles/PMC5104760/', 'https://onlinelibrary.wiley.com/doi/10.1111/psyp.70105'], 'judge_prob_variance': 0.12142131649235169, 'judge_message': '{"approach": "correctness", "judge_results": [{"judge_id": 1, "model": "gpt-4.1", "verdict": "INCORRECT", "score": 0.0, "reason": "The explanation describes a mechanism where increased perceived social support leads to increased loneliness, via dependency and unmet expectations. However, the relationship type specified is negative (suggesting that higher loneliness leads to lower perceived social support or vice versa), but the explanation instead describes a positive causal direction: more perceived support increasing loneliness. Additionally, the logic of receiving more support causing more loneliness is somewhat speculative and not tightly argued; it assumes dependency always outweighs the benefits of support, which is not a necessary consequence. The internal coherence is also weak, as the explanation does not clearly establish why increased support would systematically lead to increased loneliness rather than decreased loneliness.\\nVERDICT: INCORRECT\\nSCORE: 0.0"}], "aggregate_score": 0.0, "aggregate_verdict": "INCORRECT"}', 'max_prob_diff': 0.802291168072678, 'is_corrupted': True, 'judge_max_prob_diff': 0.5748891278733635, 'motivation': 'Higher levels of Perceived social support (MSPSS) can paradoxically contribute to increased Loneliness (UCLS) over time. When individuals consistently receive support from their social networks, they may develop a greater reliance on external validation, which can undermine their sense of personal agency and self-sufficiency. As a result, even minor fluctuations or perceived inadequacies in support can heighten feelings of isolation and loneliness, suggesting that increased Perceived social support (MSPSS) causally leads to higher Loneliness (UCLS) through a process of dependency and unmet expectations.', 'aggregate_score': 0.0, 'spurious_motivation': 'Higher levels of Perceived social support (MSPSS) can paradoxically contribute to increased Loneliness (UCLS) over time. When individuals consistently receive support from their social networks, they may develop a greater reliance on external validation, which can undermine their sense of personal agency and self-sufficiency. As a result, even minor fluctuations or perceived inadequacies in support can heighten feelings of isolation and loneliness, suggesting that increased Perceived social support (MSPSS) causally leads to higher Loneliness (UCLS) through a process of dependency and unmet expectations.', 'judge_min_prob': 0.0067630156102219076, 'mean_token_prob': 0.8636851851297134, 'min_prob': 0.09082121621548855, 'corruption_type': 'motivation', 'judge_mean_token_prob': 0.6461748283670051, 'token_prob_slope': -0.003614465071846423, 'prob_variance': 0.052530277347119556, 'relevance': 'Auto-generated relevance here', 'judge_token_prob_slope': 2.4020119257985862e-05, 'judge_prob_std': 0.34845561624452503, 'avg_nll': 0.21364801332071406, 'judge_max_window_entropy': 1.204917793003052, 'original_motivation': 'Loneliness (UCLS) causes perceived social support (MSPSS) to change in an inverse relationship. Increased loneliness directly leads to decreased perceived social support, as individuals who feel lonelier tend to perceive less support from others. Conversely, decreased loneliness is causally linked to increased perceived social support.', 'prob_std': 0.22919484581272667, 'corruption_subtype': 'spurious_motivation', 'judge_verdict': 'INCORRECT', 'perplexity': 1.2381867528386445, 'max_window_entropy': 0.8557061432146964}

