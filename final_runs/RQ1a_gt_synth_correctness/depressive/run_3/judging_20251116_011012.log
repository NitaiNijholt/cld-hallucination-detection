   Properties: {'judge_max_window_entropy': 1.2239487493623398, 'original_motivation': 'Perceived social support (MSPSS) does not causally cause daily hassles (HS) to change. MSPSS may influence how one copes with or perceives hassles, but it does not alter the occurrence or frequency of daily hassles themselves. There is no direct causal mechanism by which perceived social support changes the number or nature of daily hassles.', 'session_id': '87271a15-be98-48bd-9a89-a60ad8c9582e', 'judge_perplexity': 1.6963422150900103, 'judge_prob_variance': 0.09820286215515794, 'is_corrupted': True, 'judge_message': '{"approach": "correctness", "judge_results": [{"judge_id": 1, "model": "gpt-4.1", "verdict": "PARTIALLY_CORRECT", "score": 0.5, "reason": "The explanation is plausible (describes a reasonable mechanism\\u2014friends and family intervening to reduce hassles) and has appropriate temporality (social support is positioned as preceding and reducing hassles). However, the strength of the causal claim is weak; the explanation does not clearly convey that social support is a substantial influence, nor does it address the potential magnitude of the effect. Coherence is mostly present, but the mechanism is somewhat generalized and could be more specific. Thus, it addresses plausibility and temporality, but falls short on strength and is only moderately coherent."}], "aggregate_score": 0.5, "aggregate_verdict": "PARTIALLY_CORRECT"}', 'judge_max_prob_diff': 0.6266148190183395, 'motivation': 'Higher perceived social support directly reduces the number of daily hassles an individual experiences, as friends and family intervene to remove or solve daily problems. This means that people who feel more supported will encounter fewer hassles in their daily lives.', 'corruption_subtype': 'spurious_edge', 'aggregate_score': 0.5, 'judge_verdict': 'PARTIALLY_CORRECT', 'spurious_motivation': 'Higher perceived social support directly reduces the number of daily hassles an individual experiences, as friends and family intervene to remove or solve daily problems. This means that people who feel more supported will encounter fewer hassles in their daily lives.', 'judge_min_prob': 0.022898157555657557, 'corruption_type': 'structural', 'judge_mean_token_prob': 0.7050284186244579, 'judge_token_prob_slope': -0.0015645418190662974, 'judge_prob_std': 0.3133733590386361}

