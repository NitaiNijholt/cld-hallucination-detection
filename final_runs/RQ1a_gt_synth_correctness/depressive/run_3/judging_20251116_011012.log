   Properties: {'session_id': '87271a15-be98-48bd-9a89-a60ad8c9582e', 'judge_perplexity': 1.4941729631946927, 'citations': ['https://pmc.ncbi.nlm.nih.gov/articles/PMC10915202/', 'https://www.annualreviews.org/content/journals/10.1146/annurev.so.18.080192.000311', 'https://www.journals.uchicago.edu/doi/abs/10.1086/514478', 'https://cdc.gov/dhdsp/health_equity/psychosocial.htm'], 'judge_prob_variance': 0.08607077734203375, 'judge_message': '{"approach": "correctness", "judge_results": [{"judge_id": 1, "model": "gpt-4.1", "verdict": "INCORRECT", "score": 0.0, "reason": "The explanation fails the PLAUSIBILITY and TEMPORALITY criteria because it does not describe a mechanism by which perceived social support reduces stress; instead, it argues the reverse\\u2014that lower stress leads to higher social support\\u2014explicitly contradicting the claimed causal direction. The reasoning is internally inconsistent (COHERENCE) because it purports to explain MSPSS \\u2192 PSS while actually explaining PSS \\u2192 MSPSS. Additionally, it does not establish the STRENGTH of the supposed causal effect from social support to stress, making the explanation incorrect on all four criteria."}], "aggregate_score": 0.0, "aggregate_verdict": "INCORRECT"}', 'max_prob_diff': 0.7694620165899766, 'is_corrupted': True, 'judge_max_prob_diff': 0.7117292835735255, 'motivation': 'Perceived social support (MSPSS) leads to a reduction in perceived stress (PSS) primarily because individuals who experience lower levels of stress naturally attract more supportive social networks. As stress levels decline, people become more approachable and socially engaged, which in turn increases their access to emotional and instrumental support. Thus, the observed negative relationship arises because decreased perceived stress (PSS) enables higher perceived social support (MSPSS), rather than social support being the antecedent of reduced stress.', 'aggregate_score': 0.0, 'spurious_motivation': 'Perceived social support (MSPSS) leads to a reduction in perceived stress (PSS) primarily because individuals who experience lower levels of stress naturally attract more supportive social networks. As stress levels decline, people become more approachable and socially engaged, which in turn increases their access to emotional and instrumental support. Thus, the observed negative relationship arises because decreased perceived stress (PSS) enables higher perceived social support (MSPSS), rather than social support being the antecedent of reduced stress.', 'judge_min_prob': 0.05057999952716273, 'mean_token_prob': 0.8344091017553108, 'min_prob': 0.04643930140651386, 'corruption_type': 'motivation', 'judge_mean_token_prob': 0.7740393969567964, 'token_prob_slope': -0.005745404398645487, 'prob_variance': 0.06658089569030737, 'relevance': 'Auto-generated relevance here', 'judge_token_prob_slope': -0.001930273172806503, 'judge_prob_std': 0.29337821552056953, 'avg_nll': 0.27523663904165846, 'judge_max_window_entropy': 1.257587930123244, 'original_motivation': 'Perceived social support (MSPSS) causes perceived stress (PSS) to change in an inverse relationship. Higher perceived social support directly reduces perceived stress by providing emotional and practical resources to cope with stressors. Conversely, lower perceived social support increases perceived stress due to fewer coping resources. This causal pathway is well-established in the psychological literature.', 'prob_std': 0.2580327415083353, 'corruption_subtype': 'spurious_motivation', 'judge_verdict': 'INCORRECT', 'perplexity': 1.3168422542893101, 'max_window_entropy': 1.1903497644018755}

