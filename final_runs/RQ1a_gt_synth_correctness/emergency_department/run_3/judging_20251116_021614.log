': 1.0, 'judge_verdict': 'CORRECT', 'judge_min_prob': 0.032923872019421076, 'perplexity': 1.2812395876895917, 'mean_token_prob': 0.8586572836025612, 'min_prob': 0.05212051261379274, 'judge_mean_token_prob': 0.7568345770344996, 'token_prob_slope': -0.004778105487150483, 'prob_variance': 0.06127964564325129, 'relevance': 'Auto-generated relevance here', 'max_window_entropy': 0.8937502396722629, 'judge_token_prob_slope': -0.001153077744699294, 'judge_prob_std': 0.2952224400370936, 'avg_nll': 0.24782803719026525}

