   Properties: {'session_id': 'a9a974d2-6b6d-4fd6-8622-1e397c3cf05d', 'judge_perplexity': 1.4141276298384264, 'citations': ['https://pmc.ncbi.nlm.nih.gov/articles/PMC7049275/', 'https://www.jpain.org/article/S1526-5900(24)00549-2/fulltext', 'https://www.sciencedirect.com/science/article/pii/S027273582300079X', 'https://www.ncbi.nlm.nih.gov/books/NBK589708/'], 'judge_prob_variance': 0.0741299781116948, 'judge_message': '{"approach": "correctness", "judge_results": [{"judge_id": 1, "model": "gpt-4.1", "verdict": "CORRECT", "score": 1.0, "reason": "The explanation logically connects the willingness of a social network to therapy compliance through the mechanism of social modeling. It reasonably argues that observing supportive behaviors can lead patients to adopt similar behaviors, even in the absence of direct encouragement. The causal chain is coherent and internally consistent, with an explanation for both high and low willingness scenarios.\\nVERDICT: CORRECT\\nSCORE: 1.0"}], "aggregate_score": 1.0, "aggregate_verdict": "CORRECT"}', 'max_prob_diff': 0.6657257577456474, 'is_corrupted': True, 'judge_max_prob_diff': 0.7084230995517385, 'motivation': "Willingness of social network causes therapy compliance to change through a process of social modeling. When members of a patient's social network display high willingness to support health-related behaviors, patients observe and internalize these attitudes, leading to increased therapy compliance. Thus, the presence of a supportive network inherently demonstrates optimal health behaviors, which patients then adopt, regardless of whether the network members actively engage in direct reminders or encouragement. Conversely, low willingness within the social network leads to a lack of positive behavioral examples, reducing therapy compliance.", 'aggregate_score': 1.0, 'spurious_motivation': "Willingness of social network causes therapy compliance to change through a process of social modeling. When members of a patient's soc