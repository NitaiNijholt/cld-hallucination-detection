   Properties: {'judge_max_window_entropy': 1.1905071890532626, 'original_motivation': 'Multi-morbidity does not cause mental disorder, nor does mental disorder cause multi-morbidity, in the absence of any definitions or specified context. Without definitions, measurement, or context, no causal relationship can be established between these variables.', 'session_id': 'c4db015b-1463-4cdb-a2e8-bb589a60d60e', 'judge_perplexity': 1.5430445526947856, 'judge_prob_variance': 0.09326342724308666, 'is_corrupted': True, 'judge_message': '{"approach": "correctness", "judge_results": [{"judge_id": 1, "model": "gpt-4.1", "verdict": "INCORRECT", "score": 0.0, "reason": "The explanation asserts that multi-morbidity (having multiple chronic illnesses) directly and inevitably causes mental disorders, stating that physiological changes from these illnesses alter brain chemistry in a way that always triggers mental illness. Step by step:"}], "aggregate_score": 0.0, "aggregate_verdict": "INCORRECT"}', 'judge_max_prob_diff': 0.6983979059445814, 'motivation': 'Having multiple chronic physical illnesses (multi-morbidity) directly causes mental disorders because the physiological changes from multiple illnesses alter brain chemistry in a way that inevitably triggers mental illness. Therefore, anyone with multi-morbidity will develop a mental disorder as a direct result of their physical health conditions.', 'corruption_subtype': 'spurious_edge', 'aggregate_score': 0.0, 'judge_verdict': 'INCORRECT', 'spurious_motivation': 'Having multiple chronic physical illnesses (multi-morbidity) directly causes mental disorders because the physiological changes from multiple illnesses alter brain chemistry in a way that inevitably triggers mental illness. Therefore, anyone with multi-morbidity will develop a mental disorder as a direct result of their physical health conditions.', 'judge_min_prob': 0.047458348680809996, 'corruption_type': 'structural', 'judge_mean_token_prob': 0.7596180749066889, 'judge_