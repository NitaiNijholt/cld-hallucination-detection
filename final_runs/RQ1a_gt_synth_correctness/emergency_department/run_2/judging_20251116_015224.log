   Properties: {'session_id': '2912a778-31fc-4fe5-a7fd-cea58e98e806', 'judge_perplexity': 1.7397424177110652, 'citations': ['https://pmc.ncbi.nlm.nih.gov/articles/PMC6535998/', 'https://pmc.ncbi.nlm.nih.gov/articles/PMC5732897/', 'https://pmc.ncbi.nlm.nih.gov/articles/PMC4626077/', 'https://pmc.ncbi.nlm.nih.gov/articles/PMC9465902/'], 'judge_prob_variance': 0.09484944847923721, 'judge_message': '{"approach": "correctness", "judge_results": [{"judge_id": 1, "model": "gpt-4.1", "verdict": "PARTIALLY_CORRECT", "score": 0.5, "reason": "The explanation provides a plausible and temporally coherent mechanism (higher health literacy leads to better symptom recognition and prompt ED visits), and the causal direction is clear and justified (health literacy precedes care-seeking). However, the strength of the relationship is not clearly established\\u2014the explanation does not convey that health literacy is a substantial or key driver, and the claim could be interpreted as describing a minor effect. The reasoning is mostly coherent but could be clearer about why increased ED use is specifically attributed to health literacy rather than general health awareness, leaving some ambiguity in internal consistency."}], "aggregate_score": 0.5, "aggregate_verdict": "PARTIALLY_CORRECT"}', 'max_prob_diff': 0.8122412659853671, 'is_corrupted': True, 'judge_max_prob_diff': 0.6044866000987935, 'motivation': 'Higher health literacy increases acute care demand leading to an ED visit, as individuals with greater health knowledge are more likely to recognize subtle or early symptoms of illness and seek emergency care promptly. This heightened awareness and proactive health-seeking behavior results in a greater utilization of emergency departments, whereas those with lower health literacy may overlook or underestimate symptoms, leading to fewer ED visits overall.', 'aggregate_score': 0.5, 'spurious_motivation': 'Higher health literacy increases acute care demand leading to an ED visit, as individuals with greater health knowledge are more likely to recognize subtle or early symptoms of illness and seek emergency care promptly. This heightened awareness and proactive health-seeking behavior results in a greater utilization of emergency departments, whereas those with lower health literacy may overlook or underestimate symptoms, leading to fewer ED visits overall.', 'judge_min_prob': 0.00850825925017592, 'mean_token_prob': 0.8644808252661101, 'min_prob': 0.05859137720678673, 'corruption_type': 'motivation', 'judge_mean_token_prob': 0.6915352617105437, 'token_prob_slope': -0.002053284730578728, 'prob_variance': 0.052762667468171424, 'relevance': 'Auto-generated relevance here', 'judge_token_prob_slope': -0.003327795303897401, 'judge_prob_std': 0.3079763764954014, 'avg_nll': 0.22387785138867217, 'judge_max_window_entropy': 1.2970241177360298, 'original_motivation': 'Health literacy causes acute care demand leading to an ED visit to change in an inverse relationship. Higher health literacy enables individuals to better understand and manage their health, which can prevent unnecessary acute care episodes and reduce ED visits. Conversely, lower health literacy increases the likelihood of mismanaging health issues, leading to higher acute care demand and more ED visits.', 'prob_std': 0.22970125700172261, 'corruption_subtype': 'spurious_motivation', 'judge_verdict': 'PARTIALLY_CORRECT', 'perplexity': 1.2509182121734537, 'max_window_entropy': 0.8520598471601237}

