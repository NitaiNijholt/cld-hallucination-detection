   Properties: {'session_id': '2912a778-31fc-4fe5-a7fd-cea58e98e806', 'judge_perplexity': 2.4190853486497293e+42, 'citations': ['https://www.nature.com/articles/s44271-025-00215-8', 'https://pmc.ncbi.nlm.nih.gov/articles/PMC4651456/', 'https://resolve.cambridge.org/core/books/abs/relationship-maintenance/social-networks-and-relationship-maintenance/A46CFC3E4A8548B7000D7D1B85702AD0', 'https://www.cdc.gov/social-connectedness/risk-factors/index.html', 'https://www.ncbi.nlm.nih.gov/books/NBK585650/'], 'judge_prob_variance': 0.10137755447690872, 'judge_message': '{"approach": "correctness", "judge_results": [{"judge_id": 1, "model": "gpt-4.1", "verdict": "PARTIALLY_CORRECT", "score": 0.5, "reason": "The explanation outlines a plausible mechanism (peer scrutiny and stigma increasing care avoidance), articulates the correct causal direction, and maintains logical coherence without circularity. However, it does not convincingly establish the strength or substantial importance of the relationship, as it relies on speculative language (\\"may fear,\\" \\"can heighten\\") and does not clearly convey that network size is a major influence rather than a minor or context-dependent factor."}], "aggregate_score": 0.5, "aggregate_verdict": "PARTIALLY_CORRECT"}', 'max_prob_diff': 0.7218309065697311, 'is_corrupted': True, 'judge_max_prob_diff': 0.6700980969403385, 'motivation': 'A larger size of social network often increases social obligations and perceived scrutiny from peers, which can heighten stress and anxiety related to seeking care. Individuals with more extensive social networks may fear judgment or stigma if they disclose health concerns, leading them to avoid care more frequently. In contrast, those with a smaller size of social network may experience less social pressure and thus feel more comfortable seeking care, resulting in lower care avoidance behavior. This suggests that size of social network exerts a direct influence on care avoidance behavior through social evaluation mechanisms.', 'aggregate_score': 0.5, 'spurious_motivation': 'A larger size of social network often increases social obligations and perceived scrutiny from peers, which can heighten stress and anxiety related to seeking care. Individuals with more extensive social networks may fear judgment or stigma if they disclose health concerns, leading them to avoid care more frequently. In contrast, those with a smaller size of social network may experience less social pressure and thus feel more comfortable seeking care, resulting in lower care avoidance behavior. This suggests that size of social network exerts a direct influence on care avoidance behavior through social evaluation mechanisms.', 'judge_min_prob': 0.0, 'mean_token_prob': 0.8121263257439483, 'min_prob': 0.09363993859085128, 'corruption_type': 'motivation', 'judge_mean_token_prob': 0.7336843232558873, 'token_prob_slope': -0.005127852104712371, 'prob_variance': 0.06987398925810194, 'relevance': 'Auto-generated relevance here', 'judge_token_prob_slope': -0.0018126381076341454, 'judge_prob_std': 0.3183984209711297, 'avg_nll': 0.2963304024554412, 'judge_max_window_entropy': 1.119966979973057, 'original_motivation': 'Size of social network causes care avoidance behavior to change in an inverse relationship. A larger social network typically provides more support, information, and encouragement, thereby reducing care avoidance behavior. Conversely, a smaller social network can lead to increased isolation and higher care avoidance. This is a direct causal relationship where social network size influences care-seeking behavior.', 'prob_std': 0.26433688592041393, 'corruption_subtype': 'spurious_motivation', 'judge_verdict': 'PARTIALLY_CORRECT', 'perplexity': 1.3449144464662888, 'max_window_entropy': 1.2012128188701698}

