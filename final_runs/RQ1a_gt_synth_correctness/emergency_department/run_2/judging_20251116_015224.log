   Properties: {'session_id': '0651a889-37c0-4677-968e-530886118255', 'judge_perplexity': 1.5329806774965868, 'citations': ['https://depts.washington.edu/bhdept/ethics-medicine/bioethics-topics/detail/60', 'https://nam.edu/perspectives/burnout-among-health-care-professionals-a-call-to-explore-and-address-this-underrecognized-threat-to-safe-high-quality-care/', 'https://www.frontiersin.org/journals/public-health/articles/10.3389/fpubh.2021.679397/full', 'https://pmc.ncbi.nlm.nih.gov/articles/PMC10484337/'], 'judge_prob_variance': 0.08424145814831696, 'judge_message': '{"approach": "correctness", "judge_results": [{"judge_id": 1, "model": "gpt-4.1", "verdict": "INCORRECT", "score": 0.0, "reason": "The explanation describes a process by which fear and shame lead to increased vigilance and adherence to protocols, which would plausibly improve functioning. However, this is inconsistent with the stated relationship type (NEGATIVE), which implies that fear and shame should decrease functioning. The argument actually supports a positive relationship, not a negative one. Therefore, the causal reasoning as presented is internally inconsistent.\\nVERDICT: INCORRECT\\nSCORE: 0.0"}], "aggregate_score": 0.0, "aggregate_verdict": "INCORRECT"}', 'max_prob_diff': 0.7288815310254716, 'is_corrupted': True, 'judge_max_prob_diff': 0.6795973605649687, 'motivation': 'Feelings of fear and shame stimulate a heightened sense of personal accountability and vigilance among healthcare professionals, which in turn directly enhances their functioning. By fostering a persistent awareness of potential mistakes and social judgment, these emotions drive professionals to adhere more strictly to protocols and double-check their work, thereby boosting overall performance. Thus, increasing feelings of fear and shame can be expected to yield improvements in the functioning of healthcare professionals, as suggested by theories emphasizing the motivational role of negative affect in performance optimization.', 'aggregate_score': 0.0, 'spurious_motivation': 'Feelings of fear and shame stimulate a heightened sense of personal accountability and vigilance among healthcare professionals, which in turn directly enhances their functioning. By fostering a persistent awareness of potential mistakes and social judgment, these emotions drive professionals to adhere more strictly to protocols and double-check their work, thereby boosting overall performance. Thus, increasing feelings of fear and shame can be expected to yield improvements in the functioning of healthcare professionals, as suggested by theories emphasizing the motivational role of negative affect in performance optimization.', 'judge_min_prob': 0.012332369093621192, 'mean_token_prob': 0.8084463082995977, 'min_prob': 0.03719328925911246, 'corruption_type': 'motivation', 'judge_mean_token_prob': 0.7595905983733041, 'token_prob_slope': -0.005988941965060891, 'prob_variance': 0.06241281997706094, 'relevance': 'Auto-generated relevance here', 'judge_token_prob_slope': 0.0021867589136915855, 'judge_prob_std': 0.29024379088675945, 'avg_nll': 0.31147801912888756, 'judge_max_window_entropy': 1.0786497896914746, 'original_motivation': 'Feelings of fear and shame cause functioning of healthcare professionals to decrease in a direct causal relationship. Increased fear and shame can impair decision-making, communication, and performance, leading to reduced functioning. Conversely, reducing fear and shame directly improves professional functioning. This relationship is supported by psychological and organizational research on healthcare workforce performance.', 'prob_std': 0.24982557910882733, 'corruption_subtype': 'spurious_motivation', 'judge_verdict': 'INCORRECT', 'perplexity': 1.3654417724943662, 'max_window_entropy': 1.2207702709848745}

