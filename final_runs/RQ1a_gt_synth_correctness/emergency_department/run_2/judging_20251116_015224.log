   Properties: {'session_id': '0651a889-37c0-4677-968e-530886118255', 'judge_perplexity': 1.6794910526113545, 'citations': ['https://pmc.ncbi.nlm.nih.gov/articles/PMC2799303/', 'https://pmc.ncbi.nlm.nih.gov/articles/PMC10015351/', 'https://pmc.ncbi.nlm.nih.gov/articles/PMC7785056/', 'https://www.ed.gov/sites/ed/files/documents/students/supporting-child-student-social-emotional-behavioral-mental-health.pdf', 'https://www.cdc.gov/social-connectedness/about/index.html'], 'judge_prob_variance': 0.09743421003349999, 'judge_message': '{"approach": "correctness", "judge_results": [{"judge_id": 1, "model": "gpt-4.1", "verdict": "PARTIALLY_CORRECT", "score": 0.5, "reason": "The explanation plausibly connects a larger social network to increased health literacy and greater awareness of existing alternatives for emergency department (ED) care. However, it makes an unsupported leap by asserting that increased social awareness \\"directly results in more alternative care options being present\\"\\u2014that is, that awareness itself causes the creation of additional services and resources, rather than merely increasing knowledge of existing ones. The logic does not adequately justify how individual or collective awareness would generate new services, rather than simply identify them. Thus, the explanation conflates increased awareness with actual increases in the availability of alternatives.\\nVERDICT: PARTIALLY_CORRECT\\nSCORE: 0.5"}], "aggregate_score": 0.5, "aggregate_verdict": "PARTIALLY_CORRECT"}', 'max_prob_diff': 0.7603667957146195, 'is_corrupted': True, 'judge_max_prob_diff': 0.6228134576024362, 'motivation': 'A larger Size of social network leads to increased Availability of alternatives for ED because individuals with extensive social circles are more likely to possess higher health literacy through frequent discussions about medical experiences. This heightened awareness directly results in more alternative care options being present in their community, as social awareness itself generates additional services and resources beyond what would otherwise exist.', 'aggregate_score': 0.5, 'spurious_motivation': 'A larger Size of social network leads to increased Availability of alternatives for ED because individuals with extensive social circles are more likely to possess higher health literacy through frequent discussions about medical experiences. This heightened awareness directly results in more alternative care options being present in their community, as social awareness itself generates additional services and resources beyond what would otherwise exist.', 'judge_min_prob': 0.009937823163149109, 'mean_token_prob': 0.823212292863912, 'min_prob': 0.07424385917548082, 'corruption_type': 'motivation', 'judge_mean_token_prob': 0.7078494797781254, 'token_prob_slope': -0.002697387897903742, 'prob_variance': 0.05967312868348331, 'relevance': 'Auto-generated relevance here', 'judge_token_prob_slope': -0.0005255155529960201, 'judge_prob_std': 0.3121445338837443, 'avg_nll': 0.2748105686990277, 'judge_max_window_entropy': 1.191629345857507, 'original_motivation': 'Size of social network causally increases Availability of alternatives for ED. A larger social network provides more informal care and support options, which can serve as alternatives to visiting the emergency department (ED). Conversely, a smaller social network limits these alternatives, making ED visits more likely. This is a direct causal relationship, not merely a correlation.', 'prob_std': 0.24428083977971607, 'corruption_subtype': 'spurious_motivation', 'judge_verdict': 'PARTIALLY_CORRECT', 'perplexity': 1.3162813063689567, 'max_window_entropy': 1.0742787718234774}

