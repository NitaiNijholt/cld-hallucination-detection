   Properties: {'session_id': '2912a778-31fc-4fe5-a7fd-cea58e98e806', 'judge_perplexity': 1.598405008277231, 'citations': ['https://pmc.ncbi.nlm.nih.gov/articles/PMC6410387/', 'https://pmc.ncbi.nlm.nih.gov/articles/PMC11594359/', 'https://med.stanford.edu/news/insights/2021/10/addictive-potential-of-social-media-explained.html', 'https://pmc.ncbi.nlm.nih.gov/articles/PMC5369147/', 'https://www.sciencedirect.com/science/article/pii/S0306460322001666'], 'judge_prob_variance': 0.09241739350853002, 'judge_message': '{"approach": "correctness", "judge_results": [{"judge_id": 1, "model": "gpt-4.1", "verdict": "CORRECT", "score": 1.0, "reason": "The explanation provides a plausible mechanism by specifying how larger social networks expose individuals to diverse norms and increase social accountability, which discourages addiction (Plausibility). The temporal direction is clear; it describes how network size influences addiction, not vice versa (Temporality). The language (\\"directly reduces,\\" \\"more likely to be exposed\\") indicates that social network size is a substantial, not trivial, influence (Strength). The reasoning is internally consistent, avoiding circularity or contradiction (Coherence). All four criteria are addressed well."}], "aggregate_score": 1.0, "aggregate_verdict": "CORRECT"}', 'max_prob_diff': 0.7529434402083849, 'is_corrupted': True, 'judge_max_prob_diff': 0.6679026133391913, 'motivation': 'Size of social network causes chronic addiction to change in an inverse causal relationship. Individuals with a larger size of social network are more likely to be exposed to diverse perspectives and social norms that discourage addictive behaviors, which directly reduces chronic addiction. Furthermore, frequent social interactions within a large network increase accountability and public scrutiny, making it less likely for individuals to engage in or continue chronic addiction due to fear of social repercussions. Conversely, those with a smaller size of social network are less influenced by such external social pressures, leading to a higher propensity for chronic addiction.', 'aggregate_score': 1.0, 'spurious_motivation': 'Size of social network causes chronic addiction to change in an inverse causal relationship. Individuals with a larger size of social network are more likely to be exposed to diverse perspectives and social norms that discourage addictive behaviors, which directly reduces chronic addiction. Furthermore, frequent social interactions within a large network increase accountability and public scrutiny, making it less likely for individuals to engage in or continue chronic addiction due to fear of social repercussions. Conversely, those with a smaller size of social network are less influenced by such external social pressures, leading to a higher propensity for chronic addiction.', 'judge_min_prob': 0.004797111898291611, 'mean_token_prob': 0.820620949536223, 'min_prob': 0.1003063083238925, 'corruption_type': 'motivation', 'judge_mean_token_prob': 0.7485195199751581, 'token_prob_slope': -0.0036580026091727344, 'prob_variance': 0.06819592137882553, 'relevance': 'Auto-generated relevance here', 'judge_token_prob_slope': -0.0009169113153336199, 'judge_prob_std': 0.3040022919461793, 'avg_nll': 0.28962297397000086, 'judge_max_window_entropy': 1.2836847024846414, 'original_motivation': 'Size of social network causes chronic addiction to change in an inverse causal relationship. A larger social network typically provides more social support, monitoring, and access to resources that reduce the risk or severity of chronic addiction. Conversely, a smaller social network can increase isolation and vulnerability, directly increasing the likelihood of chronic addiction.', 'prob_std': 0.2611434881034286, 'corruption_subtype': 'spurious_motivation', 'judge_verdict': 'CORRECT', 'perplexity': 1.3359237150490104, 'max_window_entropy': 0.8436013557995874}

