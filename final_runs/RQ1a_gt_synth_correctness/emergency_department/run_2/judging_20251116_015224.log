erely correlational.', 'prob_std': 0.24676938970010928, 'corruption_subtype': 'spurious_motivation', 'judge_verdict': 'PARTIALLY_CORRECT', 'perplexity': 1.3554494909016919, 'max_window_entropy': 0.9180510299427818}

