   Properties: {'judge_max_window_entropy': 1.2515465744034375, 'original_motivation': 'Accessibility of information causes therapy compliance to increase in a direct causal relationship. When patients have easier access to relevant information about their therapy, they are more likely to understand instructions and adhere to the prescribed regimen. Conversely, limited access to information can lead to confusion and lower compliance. This relationship is supported by the mechanism that informed patients are better equipped to follow therapeutic guidelines.', 'session_id': '5cdbfe3d-f90f-4104-8143-cb756be353f5', 'judge_perplexity': 5.675717519880487e+18, 'judge_prob_variance': 0.10871029660297657, 'is_corrupted': True, 'judge_message': '{"approach": "correctness", "judge_results": [{"judge_id": 1, "model": "gpt-4.1", "verdict": "PARTIALLY_CORRECT", "score": 0.5, "reason": "The explanation presents a stepwise causal chain: \\n1) Increasing accessibility of information leads to information overload (i.e., patients have access to too much, possibly conflicting, information).\\n2) Information overload causes confusion and anxiety in patients.\\n3) Confusion and anxiety lead to decreased trust in medical advice.\\n4) Decreased trust results in reduced therapy compliance."}], "aggregate_score": 0.5, "aggregate_verdict": "PARTIALLY_CORRECT"}', 'judge_max_prob_diff': 0.5995168573471549, 'motivation': 'Increasing accessibility of information may overwhelm patients with excessive or conflicting data, causing confusion and anxiety. This information overload can lead to decreased trust in medical advice and ultimately reduce therapy compliance. Thus, better information access could actually undermine adherence to prescribed treatments.', 'corruption_subtype': 'polarity_flip', 'aggregate_score': 0.5, 'judge_verdict': 'PARTIALLY_CORRECT', 'spurious_motivation': 'Increasing accessibility of information may overwhelm patients with excessive or conflicting data, causing confusion and anxiety. This information overload can lead to decreased trust in medical advice and ultimately reduce therapy compliance. Thus, better information access could actually undermine adherence to prescribed treatments.', 'judge_min_prob': 0.0, 'original_polarity': 'POSITIVE', 'corruption_type': 'structural', 'judge_mean_token_prob': 0.6719397649904608, 'judge_token_prob_slope': -0.0004915023457389753, 'judge_prob_std': 0.3297124453261911}

