 'aggregate_score': 1.0, 'judge_verdict': 'CORRECT', 'judge_min_prob': 0.014192669524388397, 'perplexity': 1.232523295852109, 'mean_token_prob': 0.8482832413272035, 'min_prob': 0.2085793237128222, 'judge_mean_token_prob': 0.7313256989871233, 'token_prob_slope': -0.002780124535328686, 'prob_variance': 0.04437822502611819, 'relevance': 'Auto-generated relevance here', 'max_window_entropy': 0.9762135635487081, 'judge_token_prob_slope': -0.0018091551414361894, 'judge_prob_std': 0.322422465900364, 'avg_nll': 0.2090635280559665}

