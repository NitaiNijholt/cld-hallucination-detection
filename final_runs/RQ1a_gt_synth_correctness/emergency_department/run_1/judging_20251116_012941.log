   Properties: {'session_id': '39d4c582-4cdc-4641-859a-27818d9c9cba', 'judge_perplexity': 1.198076103317833e+37, 'citations': ['https://www.nist.gov/baldrige/baldrige-criteria-commentary', 'https://www.imf.org/-/media/Files/Publications/WP/2021/English/wpiea2021164-print-pdf.ashx', 'https://www.nber.org/system/files/working_papers/w10766/w10766.pdf'], 'judge_prob_variance': 0.11418019508773494, 'judge_message': '{"approach": "correctness", "judge_results": [{"judge_id": 1, "model": "gpt-4.1", "verdict": "INCORRECT", "score": 0.0, "reason": "The explanation fails key criteria. The causal mechanism is circular: it argues that capacity attracts financial resources, which increases capacity, then motivates more funding\\u2014this is primarily Capacity \\u2192 Financial resources, not the claimed Financial resources \\u2192 Capacity. Temporality is violated, as the ordering does not support the claimed direction and instead proposes reverse causation. While the explanation implies importance (strength) and is internally consistent, the core causal path is not justified, and the mechanism is circular rather than plausibly one-directional."}], "aggregate_score": 0.0, "aggregate_verdict": "INCORRECT"}', 'max_prob_diff': 0.7874410447720227, 'is_corrupted': True, 'judge_max_prob_diff': 0.6050836743283022, 'motivation': 'Financial resources cause capacity to increase because organizations with higher capacity naturally attract greater financial resources from donors and investors who perceive them as more capable and trustworthy. This influx of financial resources then leads to further increases in capacity, as the recognition of existing capacity directly motivates enhanced funding, creating a self-reinforcing cycle of growth. Conversely, organizations with lower capacity receive less financial support, which in turn limits their ability to expand capacity.', 'aggregate_score': 0.0, 'spurious_motivation': 'Financial resources cause capacity to increase because organizations with higher capacity naturally attract greater financial resources from donors and investors who perceive them as more capable and trustworthy. This influx of financial resources then leads to further increases in capacity, as the recognition of existing capacity directly motivates enhanced funding, creating a self-reinforcing cycle of growth. Conversely, organizations with lower capacity receive less financial support, which in turn limits their ability to expand capacity.', 'judge_min_prob': 0.0, 'mean_token_prob': 0.8461069211302317, 'min_prob': 0.1337118998394874, 'corruption_type': 'motivation', 'judge_mean_token_prob': 0.6756444605747339, 'token_prob_slope': -0.0027210982418902794, 'prob_variance': 0.059540743476725895, 'relevance': 'Auto-generated relevance here', 'judge_token_prob_slope': -0.003076734304433985, 'judge_prob_std': 0.33790560085286386, 'avg_nll': 0.24148717774027176, 'judge_max_window_entropy': 1.3342731004288344, 'original_motivation': 'Financial resources cause capacity to increase in a direct causal relationship. Increasing financial resources enables the acquisition of personnel, equipment, and infrastructure, directly expanding capacity. Conversely, reducing financial resources constrains the ability to maintain or grow capacity.', 'prob_std': 0.24400972004558732, 'corruption_subtype': 'spurious_motivation', 'judge_verdict': 'INCORRECT', 'perplexity': 1.2731411302666247, 'max_window_entropy': 0.8486219151640353}

