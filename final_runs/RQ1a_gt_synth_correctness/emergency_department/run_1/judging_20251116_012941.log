   Properties: {'judge_max_window_entropy': 1.167510219903974, 'original_motivation': "I don't know", 'session_id': '39d4c582-4cdc-4641-859a-27818d9c9cba', 'judge_perplexity': 1.5052985169586082, 'judge_prob_variance': 0.07554549207623486, 'is_corrupted': True, 'judge_message': '{"approach": "correctness", "judge_results": [{"judge_id": 1, "model": "gpt-4.1", "verdict": "PARTIALLY_CORRECT", "score": 0.5, "reason": "The explanation provides a plausible mechanism (increased health knowledge leads to greater awareness, which may increase fear and shame) and maintains correct temporality (health literacy precedes emotional response). However, it does not clearly convey the strength of the relationship\\u2014the influence is implied but not described as substantial or important. The reasoning is mostly coherent, but the mechanism could be articulated more specifically. Thus, it meets plausibility, temporality, and coherence reasonably well, but falls short on strength."}], "aggregate_score": 0.5, "aggregate_verdict": "PARTIALLY_CORRECT"}', 'judge_max_prob_diff': 0.6726776995632138, 'motivation': 'Higher health literacy causes an increase in feelings of fear and shame because people who know more about health risks become more worried and embarrassed about their own health behaviors and conditions. This increased awareness makes individuals feel more vulnerable and self-conscious about potential health issues.', 'corruption_subtype': 'spurious_edge', 'aggregate_score': 0.5, 'judge_verdict': 'PARTIALLY_CORRECT', 'spurious_motivation': 'Higher health literacy causes an increase in feelings of fear and shame because people who know more about health risks become more worried and embarrassed about their own health behaviors and conditions. This increased awareness makes individuals feel more vulnerable and self-conscious about potential health issues.', 'judge_min_prob': 0.027700028670604348, 'corruption_type': 'structural', 'judge_mean_token_prob': 0.7582998907792601, 'judge