   Properties: {'session_id': 'ceeb15de-be05-4191-92e3-ade330d6381d', 'judge_perplexity': 1.79968246347719, 'citations': ['https://pmc.ncbi.nlm.nih.gov/articles/PMC7719575/', 'https://pmc.ncbi.nlm.nih.gov/articles/PMC3194102/', 'https://pmc.ncbi.nlm.nih.gov/articles/PMC6410387/', 'https://pubmed.ncbi.nlm.nih.gov/22016701/'], 'judge_prob_variance': 0.10320305381570301, 'judge_message': '{"approach": "correctness", "judge_results": [{"judge_id": 1, "model": "gpt-4.1", "verdict": "CORRECT", "score": 1.0, "reason": "The explanation logically connects increased willingness of a social network to greater social scrutiny, which in turn leads to increased self-monitoring and reduced addictive behaviors, thus lowering chronic addiction. The inverse is also described coherently. The causal chain is internally consistent and plausible, and the explanation clearly states the directionality of the relationship. There are no logical fallacies or unsupported leaps within the explanation, and the assertion that the effect is direct (not mediated by other factors) is internally coherent, even if debatable in reality.\\nVERDICT: CORRECT\\nSCORE: 1.0"}], "aggregate_score": 1.0, "aggregate_verdict": "CORRECT"}', 'max_prob_diff': 0.7333978978611814, 'is_corrupted': True, 'judge_max_prob_diff': 0.5913097980983163, 'motivation': 'Willingness of social network causes chronic addiction to change in an inverse relationship. As the willingness of a social network increases, individuals may become more aware of the negative perceptions and expectations of their peers, which heightens their self-monitoring and deters them from engaging in addictive behaviors, thereby directly reducing chronic addiction. Conversely, decreased willingness of a social network removes this social scrutiny, making individuals less likely to regulate their substance use and thus increasing the severity or persistence of chronic addiction. This relationship is direct and is not contingent on individual psychological factors or external interventions.', 'aggregate_score': 1.0, 'spurious_motivation': 'Willingness of social network causes chronic addiction to change in an inverse relationship. As the willingness of a social network increases, individuals may become more aware of the negative perceptions and expectations of their peers, which heightens their self-monitoring and deters them from engaging in addictive behaviors, thereby directly reducing chronic addiction. Conversely, decreased willingness of a social network removes this social scrutiny, making individuals less likely to regulate their substance use and thus increasing the severity or persistence of chronic addiction. This relationship is direct and is not contingent on individual psychological factors or external interventions.', 'judge_min_prob': 0.008845527768267714, 'mean_token_prob': 0.7909097783809855, 'min_prob': 0.03272460153875574, 'corruption_type': 'motivation', 'judge_mean_token_prob': 0.6815947244123992, 'token_prob_slope': -0.004543330407857183, 'prob_variance': 0.0733226190674597, 'relevance': 'Auto-generated relevance here', 'judge_token_prob_slope': 0.0006834195187715154, 'judge_prob_std': 0.32125232110554935, 'avg_nll': 0.35421849798381283, 'judge_max_window_entropy': 1.285473753344917, 'original_motivation': 'Willingness of social network causes chronic addiction to change in an inverse relationship. Increased willingness of a social network to support an individual can causally reduce the severity or persistence of chronic addiction by providing social support and intervention, while decreased willingness can increase the risk or persistence of addiction. This relationship is direct and does not require mediation by other variables in the provided list.', 'prob_std': 0.27078149690748754, 'corruption_subtype': 'spurious_motivation', 'judge_verdict': 'CORRECT', 'perplexity': 1.4250665266279197, 'max_window_entropy': 1.024274358477651}

