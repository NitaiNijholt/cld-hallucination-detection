#!/bin/bash
#SBATCH --job-name=cld_judge_gtlit
#SBATCH --partition=gpu_h100
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --time=24:00:00
#SBATCH --output=finetuning/logs/%x_%j.out
#SBATCH --error=finetuning/logs/%x_%j.err

set -euo pipefail

REPO_DIR="$HOME/cld-hallucination-detection"
ENV_DIR="$REPO_DIR/venv"

echo "=========================================="
echo "Job   : $SLURM_JOB_ID  ($SLURM_JOB_NAME)"
echo "Node  : $SLURMD_NODENAME"
echo "Start : $(date)"
echo "=========================================="

module purge

cd "$REPO_DIR"
mkdir -p finetuning/logs finetuning/runs finetuning/data/gt_lit_trainval

source "$ENV_DIR/bin/activate"

export REPO_ROOT="$REPO_DIR"
export PYTHONUNBUFFERED=1
export WANDB_PROJECT=cld-judge-finetuning

python -m finetuning.src.data.prepare_gt_lit_train_val \
    --input-path finetuning/src/judge_eval_gtlit.xlsx \
    --output-dir finetuning/data/gt_lit_trainval \
    --val-fraction 0.10 \
    --seed 42

python -m finetuning.src.training.train_judge --config-name gt_lit

echo "=========================================="
echo "Done : $(date)"
echo "=========================================="
