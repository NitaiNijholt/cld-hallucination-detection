#!/bin/bash
#SBATCH --job-name=cld_judge_gtsynth_vo
#SBATCH --partition=gpu_h100
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --time=24:00:00
#SBATCH --output=finetuning/logs/%x_%j.out
#SBATCH --error=finetuning/logs/%x_%j.err

set -euo pipefail

REPO_DIR="$HOME/cld-hallucination-detection"
ENV_DIR="$REPO_DIR/venv"

module purge
cd "$REPO_DIR"
mkdir -p finetuning/logs finetuning/runs finetuning/data/verdict_only
source "$ENV_DIR/bin/activate"

export REPO_ROOT="$REPO_DIR"
export PYTHONUNBUFFERED=1
export WANDB_PROJECT=cld-judge-finetuning

python -m finetuning.src.data.prepare_judge_data \
  --output-dir finetuning/data/verdict_only \
  --objective-mode verdict_only \
  --val-fraction 0.10 \
  --seed 42 \
  --stratify-cols domain,judge_verdict

python -m finetuning.src.training.train_judge --config-name gtsynth_verdict_only
