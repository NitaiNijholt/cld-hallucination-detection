#!/bin/bash
#SBATCH --job-name=cld_judge_gtsynth_rv
#SBATCH --partition=gpu_h100
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --time=24:00:00
#SBATCH --output=/scratch-shared/nnijholt/cld-hallucination-detection/logs/%x_%j.out
#SBATCH --error=/scratch-shared/nnijholt/cld-hallucination-detection/logs/%x_%j.err

set -euo pipefail

REPO_DIR="$HOME/cld-hallucination-detection"
ENV_DIR="$REPO_DIR/venv"
SCRATCH_ROOT="/scratch-shared/nnijholt/cld-hallucination-detection"

module purge
cd "$REPO_DIR"
mkdir -p "$SCRATCH_ROOT/logs" "$SCRATCH_ROOT/runs/canonical"
source "$ENV_DIR/bin/activate"

export REPO_ROOT="$REPO_DIR"
export PYTHONUNBUFFERED=1
export WANDB_PROJECT=cld-judge-finetuning
export WANDB_DIR="${WANDB_DIR:-$SCRATCH_ROOT/wandb}"
export MLFLOW_TRACKING_URI="${MLFLOW_TRACKING_URI:-file://$SCRATCH_ROOT/mlruns}"

DATA_TAG="${CANONICAL_DATA_TAG:-$(git rev-parse --short HEAD)}"
DATA_ROOT="finetuning/data/canonical/$DATA_TAG/reason_verdict"
RUN_ROOT="${RUN_ROOT:-$SCRATCH_ROOT/runs/canonical/$DATA_TAG}"

"$ENV_DIR/bin/python" -m finetuning.src.training.train_judge \
  --config-name gtsynth_reason_verdict \
  train_file="$DATA_ROOT/judge_train.xlsx" \
  val_file="$DATA_ROOT/judge_val_synth.xlsx" \
  output_dir="$RUN_ROOT/mistral7b_judge_gtsynth_reason_verdict"
