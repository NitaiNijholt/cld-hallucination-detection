#!/bin/bash
#SBATCH --job-name=cld_eval_gtlit_rv
#SBATCH --partition=gpu_h100
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=4
#SBATCH --mem=32G
#SBATCH --time=24:00:00
#SBATCH --output=/scratch-shared/nnijholt/cld-hallucination-detection/logs/%x_%j.out
#SBATCH --error=/scratch-shared/nnijholt/cld-hallucination-detection/logs/%x_%j.err

set -euo pipefail

REPO_DIR="$HOME/cld-hallucination-detection"
ENV_DIR="$REPO_DIR/venv"
SCRATCH_ROOT="/scratch-shared/nnijholt/cld-hallucination-detection"

module purge
cd "$REPO_DIR"
mkdir -p "$SCRATCH_ROOT/logs" "$SCRATCH_ROOT/results/canonical"
source "$ENV_DIR/bin/activate"

export REPO_ROOT="$REPO_DIR"
export PYTHONUNBUFFERED=1

DATA_TAG="${CANONICAL_DATA_TAG:-$(git rev-parse --short HEAD)}"
DATA_ROOT="finetuning/data/canonical/$DATA_TAG/reason_verdict"
RUN_ROOT="${RUN_ROOT:-$SCRATCH_ROOT/runs/canonical/$DATA_TAG}"
RESULT_ROOT="${RESULT_ROOT:-$SCRATCH_ROOT/results/canonical/$DATA_TAG}"

"$ENV_DIR/bin/python" -m finetuning.src.evaluation.evaluate_judge \
  --finetuned_model "$RUN_ROOT/mistral7b_judge_gtlit_reason_verdict/lora_adapter" \
  --val_path "$DATA_ROOT/judge_val_synth_1k_stratified.xlsx" \
  --lit_path "$DATA_ROOT/gt_lit_trainval/judge_test_gtlit_1k_stratified.xlsx" \
  --output_dir "$RESULT_ROOT/gt_lit_reason_verdict" \
  --batch_size 16 \
  --model_label "Mistral-7B QLoRA (GT Lit trained, reason+verdict)"
