#!/bin/bash
#SBATCH --job-name=cld_judge_finetune
#SBATCH --partition=gpu_h100
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --time=24:00:00
#SBATCH --output=finetuning/logs/%x_%j.out
#SBATCH --error=finetuning/logs/%x_%j.err

set -euo pipefail

REPO_DIR="$HOME/cld-hallucination-detection"
ENV_DIR="$REPO_DIR/venv"

echo "=========================================="
echo "Job   : $SLURM_JOB_ID  ($SLURM_JOB_NAME)"
echo "Node  : $SLURMD_NODENAME"
echo "Start : $(date)"
echo "=========================================="

module purge

cd "$REPO_DIR"
mkdir -p finetuning/logs finetuning/runs

source "$ENV_DIR/bin/activate"

export REPO_ROOT="$REPO_DIR"
export PYTHONUNBUFFERED=1
python -m finetuning.src.training.train_judge --config-name snellius

echo "=========================================="
echo "Done : $(date)"
echo "=========================================="
