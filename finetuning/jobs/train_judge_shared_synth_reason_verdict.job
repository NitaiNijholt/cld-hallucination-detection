#!/bin/bash
#SBATCH --job-name=cld_shared_synth_rv
#SBATCH --partition=gpu_h100
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=64G
#SBATCH --time=24:00:00
#SBATCH --output=/scratch-shared/nnijholt/cld-hallucination-detection/logs/%x_%j.out
#SBATCH --error=/scratch-shared/nnijholt/cld-hallucination-detection/logs/%x_%j.err

set -euo pipefail

REPO_DIR="$HOME/cld-hallucination-detection"
ENV_DIR="$REPO_DIR/venv"

module purge
cd "$REPO_DIR"
mkdir -p /scratch-shared/nnijholt/cld-hallucination-detection/logs /scratch-shared/nnijholt/cld-hallucination-detection/runs
source "$ENV_DIR/bin/activate"

export REPO_ROOT="$REPO_DIR"
export PYTHONUNBUFFERED=1
export WANDB_PROJECT="${WANDB_PROJECT:-cld-judge-finetuning}"
export WANDB_DIR="${WANDB_DIR:-/scratch-shared/nnijholt/cld-hallucination-detection/wandb}"
export MLFLOW_TRACKING_URI="${MLFLOW_TRACKING_URI:-file:///scratch-shared/nnijholt/cld-hallucination-detection/mlruns}"

DATA_TAG="${CANONICAL_DATA_TAG:-$(git rev-parse --short HEAD)}"
DATA_ROOT="finetuning/data/canonical_shared/$DATA_TAG/reason_verdict"
RUN_ROOT="${RUN_ROOT:-/scratch-shared/nnijholt/cld-hallucination-detection/runs/canonical_shared/$DATA_TAG}"
RUN_NAME="${RUN_NAME:-mistral7b_judge_shared_synth_reason_verdict}"
mkdir -p "$RUN_ROOT" "$WANDB_DIR"

TRAIN_ARGS=()
if [[ -n "${TRAIN_MAX_EXAMPLES:-}" ]]; then
  TRAIN_ARGS+=(max_examples="$TRAIN_MAX_EXAMPLES")
fi
if [[ -n "${TRAIN_EPOCHS:-}" ]]; then
  TRAIN_ARGS+=(epochs="$TRAIN_EPOCHS")
fi
if [[ -n "${TRAIN_GRAD_ACCUM:-}" ]]; then
  TRAIN_ARGS+=(grad_accum="$TRAIN_GRAD_ACCUM")
fi
if [[ -n "${TRAIN_SAVE_STRATEGY:-}" ]]; then
  TRAIN_ARGS+=(save_strategy="$TRAIN_SAVE_STRATEGY")
fi
if [[ -n "${TRAIN_LOAD_BEST_MODEL_AT_END:-}" ]]; then
  TRAIN_ARGS+=(load_best_model_at_end="$TRAIN_LOAD_BEST_MODEL_AT_END")
fi

"$ENV_DIR/bin/python" -m finetuning.src.training.train_judge \
  --config-name gtsynth_reason_verdict \
  train_file="$DATA_ROOT/shared_train_synth.xlsx" \
  val_file="$DATA_ROOT/shared_val_synth.xlsx" \
  dataset_label="Shared GT Synth" \
  output_dir="$RUN_ROOT/$RUN_NAME" \
  "${TRAIN_ARGS[@]}"
