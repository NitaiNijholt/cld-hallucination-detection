#!/bin/bash
#SBATCH --job-name=cld_prepare_matrix
#SBATCH --partition=gpu_h100
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=4
#SBATCH --mem=16G
#SBATCH --time=02:00:00
#SBATCH --output=/scratch-shared/nnijholt/cld-hallucination-detection/logs/%x_%j.out
#SBATCH --error=/scratch-shared/nnijholt/cld-hallucination-detection/logs/%x_%j.err

set -euo pipefail

REPO_DIR="$HOME/cld-hallucination-detection"
ENV_DIR="$REPO_DIR/venv"
SCRATCH_ROOT="/scratch-shared/nnijholt/cld-hallucination-detection"

module purge
cd "$REPO_DIR"
mkdir -p "$SCRATCH_ROOT/logs" finetuning/data/canonical
source "$ENV_DIR/bin/activate"

export REPO_ROOT="$REPO_DIR"
export PYTHONUNBUFFERED=1

DATA_TAG="${CANONICAL_DATA_TAG:-$(git rev-parse --short HEAD)}"
DATA_ROOT="finetuning/data/canonical/$DATA_TAG"

"$ENV_DIR/bin/python" -m finetuning.src.data.prepare_canonical_matrix_data \
  --output-root "$DATA_ROOT" \
  --seed 42 \
  --val-fraction 0.10 \
  --test-fraction 0.10 \
  --target-n 1000 \
  --min-file-bytes 0 \
  --stratify-cols domain \
  --prompt-variant mechanistic \
  --exclude-lit-overlap-from-synth \
  --lit-eval-balance-cols domain,judge_verdict \
  --lit-eval-balance-samples-per-group 31 \
  --preserve-split-group-cols domain,judge_verdict \
  --eval-balance-cols domain,judge_verdict
