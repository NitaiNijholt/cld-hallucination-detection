#!/bin/bash
#SBATCH --job-name=cld_prepare_matrix
#SBATCH --partition=gpu_h100
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=4
#SBATCH --mem=16G
#SBATCH --time=02:00:00
#SBATCH --output=finetuning/logs/%x_%j.out
#SBATCH --error=finetuning/logs/%x_%j.err

set -euo pipefail

REPO_DIR="$HOME/cld-hallucination-detection"
ENV_DIR="$REPO_DIR/venv"

module purge
cd "$REPO_DIR"
mkdir -p finetuning/logs finetuning/data/canonical
source "$ENV_DIR/bin/activate"

export REPO_ROOT="$REPO_DIR"
export PYTHONUNBUFFERED=1

DATA_TAG="${CANONICAL_DATA_TAG:-$(git rev-parse --short HEAD)}"
DATA_ROOT="finetuning/data/canonical/$DATA_TAG"

python -m finetuning.src.data.prepare_canonical_matrix_data \
  --output-root "$DATA_ROOT" \
  --seed 42 \
  --val-fraction 0.10 \
  --test-fraction 0.10 \
  --target-n 1000 \
  --stratify-cols domain,judge_verdict
