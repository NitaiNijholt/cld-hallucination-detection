#!/bin/bash
#SBATCH --job-name=cld_eval_gtlit_vo
#SBATCH --partition=gpu_h100
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=4
#SBATCH --mem=32G
#SBATCH --time=24:00:00
#SBATCH --output=finetuning/logs/%x_%j.out
#SBATCH --error=finetuning/logs/%x_%j.err

set -euo pipefail

REPO_DIR="$HOME/cld-hallucination-detection"
ENV_DIR="$REPO_DIR/venv"

module purge
cd "$REPO_DIR"
mkdir -p finetuning/logs results_gtlit_verdict_only finetuning/data/verdict_only/gt_lit_trainval
source "$ENV_DIR/bin/activate"

export REPO_ROOT="$REPO_DIR"
export PYTHONUNBUFFERED=1

python -m finetuning.src.data.prepare_judge_data \
  --output-dir finetuning/data/verdict_only \
  --objective-mode verdict_only \
  --val-fraction 0.10 \
  --seed 42 \
  --stratify-cols domain,judge_verdict

python -m finetuning.src.data.prepare_gt_lit_train_val \
  --input-path finetuning/data/verdict_only/judge_eval_gtlit.xlsx \
  --output-dir finetuning/data/verdict_only/gt_lit_trainval \
  --val-fraction 0.10 \
  --test-fraction 0.10 \
  --seed 42 \
  --stratify-cols domain,judge_verdict

python -m finetuning.src.evaluation.create_eval_subsamples \
  --val_path finetuning/data/verdict_only/judge_val_synth.xlsx \
  --lit_path finetuning/data/verdict_only/judge_eval_gtlit.xlsx \
  --target_n 1000 \
  --seed 42 \
  --stratify-cols domain,judge_verdict \
  --output-suffix _1k_stratified

python -m finetuning.src.evaluation.create_gt_lit_test_subsample \
  --input_path finetuning/data/verdict_only/gt_lit_trainval/judge_test_gtlit.xlsx \
  --output_path finetuning/data/verdict_only/gt_lit_trainval/judge_test_gtlit_1k_stratified.xlsx \
  --target_n 1000 \
  --seed 42 \
  --stratify-cols domain,judge_verdict

python -m finetuning.src.evaluation.evaluate_judge \
  --finetuned_model finetuning/runs/mistral7b_judge_gtlit_verdict_only/lora_adapter \
  --val_path finetuning/data/verdict_only/judge_val_synth_1k_stratified.xlsx \
  --lit_path finetuning/data/verdict_only/gt_lit_trainval/judge_test_gtlit_1k_stratified.xlsx \
  --output_dir results_gtlit_verdict_only \
  --batch_size 16 \
  --model_label "Mistral-7B QLoRA (GT Lit trained, verdict-only)"
