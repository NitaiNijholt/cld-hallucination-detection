#!/bin/bash
#SBATCH --job-name=cld_judge_cls
#SBATCH --partition=gpu_h100
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=4
#SBATCH --mem=32G
#SBATCH --time=02:00:00
#SBATCH --output=/scratch-shared/nnijholt/cld-hallucination-detection/logs/%x_%j.out
#SBATCH --error=/scratch-shared/nnijholt/cld-hallucination-detection/logs/%x_%j.err

set -euo pipefail

REPO_DIR="$HOME/cld-hallucination-detection"
ENV_DIR="$REPO_DIR/venv"
SCRATCH_ROOT="/scratch-shared/nnijholt/cld-hallucination-detection"

echo "=========================================="
echo "Job   : $SLURM_JOB_ID  (classification compare)"
echo "Node  : $SLURMD_NODENAME"
echo "Start : $(date)"
echo "=========================================="

module purge

cd "$REPO_DIR"
mkdir -p "$SCRATCH_ROOT/logs" "$SCRATCH_ROOT/results"

source "$ENV_DIR/bin/activate"

export REPO_ROOT="$REPO_DIR"
export PYTHONUNBUFFERED=1

python -m finetuning.src.evaluation.eval_classification_compare \
    --finetuned_model "$SCRATCH_ROOT/runs/mistral7b_judge_gtsynth/lora_adapter" \
    --val_path finetuning/src/judge_val_synth.xlsx \
    --lit_path finetuning/src/judge_eval_gtlit.xlsx \
    --output_dir "$SCRATCH_ROOT/results/legacy_eval_classification"

echo "=========================================="
echo "Done : $(date)"
echo "=========================================="
