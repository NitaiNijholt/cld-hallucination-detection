#!/bin/bash
#SBATCH --job-name=cld_judge_eval
#SBATCH --partition=gpu_h100
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=4
#SBATCH --mem=32G
#SBATCH --time=56:00:00
#SBATCH --output=finetuning/logs/%x_%j.out
#SBATCH --error=finetuning/logs/%x_%j.err

set -euo pipefail

REPO_DIR="$HOME/cld-hallucination-detection"
ENV_DIR="$REPO_DIR/venv"

echo "=========================================="
echo "Job   : $SLURM_JOB_ID  (eval judge)"
echo "Node  : $SLURMD_NODENAME"
echo "Start : $(date)"
echo "=========================================="

module purge

cd "$REPO_DIR"
mkdir -p finetuning/logs results

source "$ENV_DIR/bin/activate"

export REPO_ROOT="$REPO_DIR"
export PYTHONUNBUFFERED=1

# Create subsamples (~1000 each) for balanced, faster eval
python -m finetuning.src.evaluation.create_eval_subsamples \
    --val_path finetuning/src/judge_val_synth.xlsx \
    --lit_path finetuning/src/judge_eval_gtlit.xlsx \
    --target_n 1000 --seed 42

# Full eval: finetuned + base, both splits (transformers backend; vLLM fails on Snellius Triton)
python -m finetuning.src.evaluation.evaluate_judge \
    --finetuned_model finetuning/runs/mistral7b_judge_gtsynth/lora_adapter \
    --val_path finetuning/src/judge_val_synth_1k.xlsx \
    --lit_path finetuning/src/judge_eval_gtlit_1k.xlsx \
    --output_dir results \
    --batch_size 16

echo "=========================================="
echo "Done : $(date)"
echo "=========================================="
