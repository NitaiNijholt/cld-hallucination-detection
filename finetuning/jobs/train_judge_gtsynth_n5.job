#!/bin/bash
#SBATCH --job-name=cld_judge_gtsynth_n5
#SBATCH --partition=gpu_h100
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=1
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=4
#SBATCH --mem=32G
#SBATCH --time=00:20:00
#SBATCH --output=/scratch-shared/nnijholt/cld-hallucination-detection/logs/%x_%j.out
#SBATCH --error=/scratch-shared/nnijholt/cld-hallucination-detection/logs/%x_%j.err

set -euo pipefail

REPO_DIR="$HOME/cld-hallucination-detection"
ENV_DIR="$REPO_DIR/venv"
SCRATCH_ROOT="/scratch-shared/nnijholt/cld-hallucination-detection"

echo "=========================================="
echo "Job   : $SLURM_JOB_ID  ($SLURM_JOB_NAME)"
echo "Node  : $SLURMD_NODENAME"
echo "Start : $(date)"
echo "=========================================="

module purge

cd "$REPO_DIR"
mkdir -p "$SCRATCH_ROOT/logs" "$SCRATCH_ROOT/runs"

source "$ENV_DIR/bin/activate"

export REPO_ROOT="$REPO_DIR"
export PYTHONUNBUFFERED=1
export WANDB_DISABLED=true

python -m finetuning.src.training.train_judge \
  --config-name gtsynth_fixed \
  max_examples=5 \
  epochs=1 \
  grad_accum=1 \
  save_strategy=no \
  load_best_model_at_end=false \
  output_dir="$SCRATCH_ROOT/runs/mistral7b_judge_gtsynth_smoke_n5"

echo "=========================================="
echo "Done : $(date)"
echo "=========================================="
