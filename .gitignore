# Python cache
**/__pycache__/
*.pyc
*.pyo

# Thesis backup
thesis/final_thesis/def_submission_template/Figures/final_runs_old_backup/

# =========================================================================
# THESIS CLEANUP - Unused directories/files
# =========================================================================
# Old thesis structure (only reproducible_version is used)
thesis/final_thesis/
thesis/pptx_images/
thesis/reproducible_thesis/
thesis/interesting articles/
thesis/Figures/
thesis/chapters/
thesis/Chapters/
thesis/diagrams/
thesis/Pictures/
thesis/appendices/
thesis/Appendices/

# LaTeX compilation artifacts at thesis root
thesis/*.aux
thesis/*.bbl
thesis/*.blg
thesis/*.log
thesis/*.fdb_latexmk
thesis/*.fls
thesis/*.lof
thesis/*.lot
thesis/*.out
thesis/*.toc
thesis/*.pdf

# Old experiment images
thesis/exp-*.png
thesis/image.png

# Debug scripts
thesis/debug_*.py
final_runs/supp_prompt_sensitivity/prompt_sensitivity_figure.png
final_runs/supp_prompt_sensitivity/corrector_sensitivity_figure.png

# Generated outputs (regenerated by reproduction scripts)
# PNGs in final_runs are generated, but we need placeholders for thesis to compile
# Placeholder PNGs are force-added with: git add -f final_runs/**/*.png
# This rule is kept so regenerated figures don't auto-stage
final_runs/**/*.png
# Exception: thesis/Figures needs static assets
!thesis/reproducible_version/Figures/*.png

# Most .tex files in final_runs are generated, BUT we need placeholders for \input
# The placeholder files are force-added with git add -f

# =========================================================================
# STRAY FILES IN ROOT (generated when running scripts from wrong directory)
# =========================================================================
# These should be generated in final_runs/*/Output/ not in root
/*.png
/output/
.cursor/
