# Local environment files (never commit secrets)
.env
.env.*
.envrc



# =========================================================================
# PROPRIETARY CODE - NOT INCLUDED IN PUBLIC REPRODUCTION
# =========================================================================
# The data_science directory contains proprietary experiment code.
# All reproduction functionality is self-contained in final_runs/
data_science/

# =========================================================================
# UNUSED DIRECTORIES (removed from repo, kept in .gitignore)
# =========================================================================
